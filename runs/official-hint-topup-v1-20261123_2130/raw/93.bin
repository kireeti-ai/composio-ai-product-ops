<script>
  // Perf: only load Swiper (JS+CSS) on pages that actually use it.
  // Matches the same selector the Swiper init code below already targets,
  // so behavior is unchanged on pages that use it and zero bytes load on pages that don't (e.g. /learn).
  if (document.querySelector('.swiper, .swiper-wrapper, [data-slider="infinite"]')) {
    document.write('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />');
    document.write('<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"><\/script>');
  }
</script>

<script>
(() => {
  // Constant speed (px/sec) per breakpoint
  const pxPerSecondDesktop = 70;
  const pxPerSecondTablet  = 50;
  const pxPerSecondMobile  = 40;

  // Visual gap between slides (via Swiper's spaceBetween)
  const gapPx = 20;

  if (!window.Swiper) return;

  document.querySelectorAll('.swiper-wrapper[data-slider="infinite"]').forEach(wrapper => {
    const desktop = parseInt(wrapper.getAttribute('data-left-slides-desktop'), 10) || 3;
    const tablet  = parseInt(wrapper.getAttribute('data-left-slides-tablet'), 10)  || 2;
    const mobile  = parseInt(wrapper.getAttribute('data-left-slides-mobile'), 10)  || 1;

    const container = wrapper.closest('.swiper');
    if (!container) return;

    // 1) Swiper for layout only (no autoplay/loop, disable Swiper drag so we can control it)
    const swiper = new Swiper(container, {
      slidesPerView: mobile,
      spaceBetween: gapPx,
      allowTouchMove: false,   // <-- important: we'll handle drag ourselves
      speed: 0,
      breakpoints: {
        660: { slidesPerView: tablet,  spaceBetween: gapPx },
        990: { slidesPerView: desktop, spaceBetween: gapPx }
      }
    });

    // --- utilities
    const slidesSel = () =>
      Array.from(wrapper.children).filter(n => n.classList?.contains('swiper-slide'));

    const slideFullWidth = (el) => {
      const rect = el.getBoundingClientRect();
      const mr = parseFloat(getComputedStyle(el).marginRight || '0');
      return rect.width + mr; // include Swiper gap
    };

    const totalWidth = () => slidesSel().reduce((sum, s) => sum + slideFullWidth(s), 0);

    // Freeze the first cycle (original CMS order)
    const originalSlides = slidesSel();
    const cycleCount = originalSlides.length;

    // Build enough whole-cycle copies for smooth wrap (supports overflow:visible)
    function ensureEnoughCycles() {
      const need = container.clientWidth * 2; // at least ~2× viewport
      if (slidesSel().length === cycleCount) {
        const frag = document.createDocumentFragment();
        originalSlides.forEach(s => frag.appendChild(s.cloneNode(true)));
        wrapper.appendChild(frag);
      }
      let guard = 0;
      while (totalWidth() < need && guard < 20) {
        const frag = document.createDocumentFragment();
        originalSlides.forEach(s => frag.appendChild(s.cloneNode(true)));
        wrapper.appendChild(frag);
        guard++;
      }
    }
    ensureEnoughCycles();

    // Measure width of one full cycle
    function cycleWidth() {
      const all = slidesSel();
      let sum = 0;
      for (let i = 0; i < Math.min(cycleCount, all.length); i++) {
        sum += slideFullWidth(all[i]);
      }
      return sum;
    }

    // --- speed (px/ms) by breakpoint
    const currentPxPerMs = () => {
      const w = window.innerWidth;
      const pxps = (w < 660) ? pxPerSecondMobile
                  : (w < 990) ? pxPerSecondTablet
                              : pxPerSecondDesktop;
      return pxps / 1000;
    };

    // --- state
    let rafId = null;
    let paused = false;        // autoplay state
    let hovered = false;       // hover state
    let dragging = false;      // drag state
    let lastTs = performance.now();
    let tx = 0;                // current translateX (negative = moving left)

    // Normalize tx into [-cW, 0) to avoid drift, preserving exact pixel offset
    function normalizeTx() {
      const cW = cycleWidth();
      if (cW <= 0) return;
      // Keep tx within [-cW, 0)
      if (tx <= -cW || tx > 0) {
        tx = ((tx % cW) + cW) % cW; // now in [0, cW)
        tx = tx === 0 ? 0 : tx - cW; // convert to (-cW, 0]
      }
    }

    // --- rAF conveyor loop
    function step(ts) {
      const dt = ts - lastTs;
      lastTs = ts;

      if (!paused && !dragging) {
        tx -= currentPxPerMs() * dt;

        // Wrap by whole cycle when off-screen; this is modulo-safe
        normalizeTx();

        wrapper.style.transition = 'none';
        wrapper.style.transform = `translate3d(${tx}px,0,0)`;
      }
      rafId = requestAnimationFrame(step);
    }

    // --- hover pause
    function stopAutoplay() {
      hovered = true;
      paused = true; // freeze exactly where it is
      const t = getComputedStyle(wrapper).transform;
      wrapper.style.transition = 'none';
      if (t && t !== 'none') wrapper.style.transform = t;
    }
    function startAutoplay() {
      hovered = false;
      if (!dragging) paused = false; // resume only if not dragging
    }

    container.addEventListener('mouseenter', stopAutoplay,  { passive: true });
    container.addEventListener('mouseleave', startAutoplay, { passive: true });

    // --- pointer drag (mouse + touch unified)
    let dragStartX = 0;
    let dragStartY = 0;
    let lastX = 0;
    let lockedAxis = null; // 'x' or 'y' once movement is clear
    const AXIS_THRESHOLD = 6; // px

    function onPointerDown(e) {
      dragging = true;
      paused = true; // pause autoplay immediately
      lockedAxis = null;
      dragStartX = lastX = (e.clientX ?? e.touches?.[0]?.clientX ?? 0);
      dragStartY = (e.clientY ?? e.touches?.[0]?.clientY ?? 0);

      // Capture pointer (for mouse)
      e.target.setPointerCapture?.(e.pointerId);
    }

    function onPointerMove(e) {
      if (!dragging) return;

      const cx = (e.clientX ?? e.touches?.[0]?.clientX ?? lastX);
      const cy = (e.clientY ?? e.touches?.[0]?.clientY ?? dragStartY);

      const dx = cx - lastX;
      const dy = cy - dragStartY;

      if (!lockedAxis) {
        if (Math.abs(dx) > AXIS_THRESHOLD || Math.abs(dy) > AXIS_THRESHOLD) {
          lockedAxis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        }
      }

      // Only prevent scrolling if we're dragging horizontally
      if (lockedAxis === 'x') {
        e.preventDefault?.();
        tx += dx;  // follow the finger exactly (note: dx positive moves right)
        normalizeTx();
        wrapper.style.transition = 'none';
        wrapper.style.transform = `translate3d(${tx}px,0,0)`;
      }

      lastX = cx;
    }

    function onPointerUp(e) {
      // Release capture
      e.target.releasePointerCapture?.(e.pointerId);

      dragging = false;
      // If still hovered, remain paused; otherwise resume autoplay from EXACT tx
      if (!hovered) paused = false;
    }

    // Attach pointer listeners
    container.addEventListener('pointerdown', onPointerDown, { passive: true });
    container.addEventListener('pointermove', onPointerMove, { passive: false }); // we may preventDefault
    container.addEventListener('pointerup', onPointerUp, { passive: true });
    container.addEventListener('pointercancel', onPointerUp, { passive: true });
    container.addEventListener('lostpointercapture', onPointerUp, { passive: true });

    // Kick off loop
    cancelAnimationFrame(rafId);
    lastTs = performance.now();
    rafId = requestAnimationFrame(step);

    // Rebuild on resize/breakpoints and keep visual position
    function rebuildForResize() {
      const cWOld = cycleWidth();
      const offsetMod = cWOld > 0 ? ((-tx % cWOld) + cWOld) % cWOld : 0;

      // Remove extra copies, keep first cycle
      const all = slidesSel();
      for (let i = all.length - 1; i >= cycleCount; i--) wrapper.removeChild(all[i]);

      ensureEnoughCycles();

      const cWNew = cycleWidth();
      tx = cWNew > 0 ? -Math.min(offsetMod, cWNew - 1) : 0;

      wrapper.style.transition = 'none';
      wrapper.style.transform = `translate3d(${tx}px,0,0)`;
    }
    swiper.on('resize', rebuildForResize);
    swiper.on('breakpoint', rebuildForResize);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { paused = true; }
      else if (!hovered && !dragging) { paused = false; }
    });

    // Perf hint
    wrapper.style.willChange = 'transform';
  });
})();
</script>

<script>
(() => {
  const partnerKeyParam = "ps_partner_key";

  // Update these to match your app links or button selectors
  const linkSelectors = [
    'a[href*="https://fathom.video/users/sign_up"]',
	'a[href*="https://fathom.video/users/sign_in"]',
    'a[href*="https://fathomvideo.typeform.com"]'
    // '.signup-button',
    // '.login-button',
    // '[data-pass-partner="true"]'
  ];

  const pageParams = new URLSearchParams(window.location.search);

  // 1) Get partner key from URL, otherwise from localStorage
  const partnerKeyFromUrl = pageParams.get(partnerKeyParam);
  const partnerKeyFromStorage = localStorage.getItem(partnerKeyParam);
  const partnerKeyValue = partnerKeyFromUrl || partnerKeyFromStorage;

  // 2) If URL has it, store/update localStorage
  if (partnerKeyFromUrl) {
    localStorage.setItem(partnerKeyParam, partnerKeyFromUrl);
  }

  if (!partnerKeyValue) return;

  // 3) Append ONLY ps_partner_key to existing hrefs (preserve everything else)
  const links = document.querySelectorAll(linkSelectors.join(","));

  links.forEach((link) => {
    const rawHref = link.getAttribute("href");
    if (!rawHref) return;

    try {
      const linkUrl = new URL(rawHref, window.location.origin);

      // Don't overwrite if app already put one there
      if (!linkUrl.searchParams.has(partnerKeyParam)) {
        linkUrl.searchParams.set(partnerKeyParam, partnerKeyValue);
        link.setAttribute("href", linkUrl.toString());
      }
    } catch (e) {
    }
  });
})();
</script>

<script>
(() => {
  const paramsToPersist = ["ps_partner_key", "ps_xid"];

  // Update these to match your app links or button selectors
  const linkSelectors = [
    'a[href*="https://fathom.video/users/sign_up"]',
    'a[href*="https://fathom.video/users/sign_in"]',
    'a[href*="https://fathomvideo.typeform.com"]'
    // '.signup-button',
    // '.login-button',
    // '[data-pass-partner="true"]'
  ];

  const pageParams = new URLSearchParams(window.location.search);

  // 1) Get values from URL first, otherwise from localStorage
  const values = {};
  paramsToPersist.forEach((key) => {
    const fromUrl = pageParams.get(key);
    const fromStorage = localStorage.getItem(key);
    values[key] = fromUrl || fromStorage || "";
  });

  // 2) If URL has them, store/update localStorage
  paramsToPersist.forEach((key) => {
    const fromUrl = pageParams.get(key);
    if (fromUrl) localStorage.setItem(key, fromUrl);
  });

  // If neither exists, exit
  const hasAny = paramsToPersist.some((key) => values[key]);
  if (!hasAny) return;

  // 3) Append params to existing hrefs (preserve everything else)
  const links = document.querySelectorAll(linkSelectors.join(","));

  links.forEach((link) => {
    const rawHref = link.getAttribute("href");
    if (!rawHref) return;

    try {
      const linkUrl = new URL(rawHref, window.location.origin);

      paramsToPersist.forEach((key) => {
        // Don't overwrite if app already put one there
        if (values[key] && !linkUrl.searchParams.has(key)) {
          linkUrl.searchParams.set(key, values[key]);
        }
      });

      link.setAttribute("href", linkUrl.toString());
    } catch (e) {}
  });
})();
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const bannerSelector = "[data-banner='wrapper']";
  const closeSelector = "[data-banner-close]";
  const storageKey = "bannerDismissed_session";
  const collapseDuration = 320; // matches 300ms max-height transition + buffer

  const urlParams = new URLSearchParams(window.location.search);

  // data-show / data-hide accept:
  // - "campaign=promo" (exact match)
  // - "campaign" (param exists)
  // - multiple via commas: "campaign=promo, utm_source=google"
  const parseRules = (raw) => {
    const text = String(raw || "").trim();
    if (!text) return [];

    return text
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean)
      .map((rule) => {
        const eqIndex = rule.indexOf("=");
        if (eqIndex === -1) return { key: rule, value: null, type: "exists" };

        return {
          key: rule.slice(0, eqIndex).trim(),
          value: rule.slice(eqIndex + 1).trim(),
          type: "equals",
        };
      })
      .filter((r) => r.key);
  };

  const matchesRule = (rule) => {
    if (rule.type === "exists") return urlParams.has(rule.key);
    const values = urlParams.getAll(rule.key); // supports repeated params
    return values.some((v) => v === rule.value);
  };

  const anyMatch = (rules) => rules.some(matchesRule);

  const setBannerVisible = (el, isVisible) => {
    if (!el) return;
    if (isVisible) {
      // ensures transition fires
      requestAnimationFrame(() => el.classList.add("isBannerVisible"));
      el.setAttribute("aria-hidden", "false");
    } else {
      el.classList.remove("isBannerVisible");
      el.setAttribute("aria-hidden", "true");
    }
  };

  const hideAllBanners = () => {
    document.querySelectorAll(bannerSelector).forEach((el) => setBannerVisible(el, false));
  };

  // If dismissed already this session, keep hidden and stop.
  if (document.documentElement.classList.contains("bannerDismissed")) {
    hideAllBanners();
    return;
  }

  // Apply URL rule logic per banner
  document.querySelectorAll(bannerSelector).forEach((el) => {
    const showRules = parseRules(el.getAttribute("data-show"));
    const hideRules = parseRules(el.getAttribute("data-hide"));

    // If data-show exists: must match at least one
    const passesShow = showRules.length ? anyMatch(showRules) : true;

    // If data-hide matches: hide wins
    const hitsHide = hideRules.length ? anyMatch(hideRules) : false;

    const shouldShow = passesShow && !hitsHide;
    setBannerVisible(el, shouldShow);
  });

  // Close handling: dismiss for session (GLOBAL)
  document.addEventListener("click", (e) => {
    const closeBtn = e.target.closest(closeSelector);
    if (!closeBtn) return;

    try { sessionStorage.setItem(storageKey, "true"); } catch (err) {}

    document.documentElement.classList.remove("bannerAllowed");
    document.documentElement.classList.add("bannerDismissed");

    // slide out any currently visible banner(s)
    hideAllBanners();

    // Webflow's navbar caches its position; once the banner has collapsed,
    // trigger a resize so the mobile menu remeasures from the new nav position
    setTimeout(() => {
      window.dispatchEvent(new Event("resize"));
    }, collapseDuration);
  });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const urlParams = new URLSearchParams(window.location.search);

  // Put this attribute on any element whose text can include tokens, e.g.:
  // <div data-banner-tokenize>Hi {from}, welcome to Fathom</div>
  const tokenizeSelector = "[data-banner-tokenize]";

  const escapeHtml = (value) => {
    const div = document.createElement("div");
    div.textContent = value == null ? "" : String(value);
    return div.textContent; // safe text (no HTML)
  };

  const getParamValue = (key) => {
    // Use first occurrence if repeated (?from=a&from=b)
    const v = urlParams.get(key);
    return v == null ? "" : v;
  };

  const replaceTokens = (text) => {
    // Supports:
    // {from} -> value of "from"
    // {from|there} -> value of "from" OR "there" if missing/empty
    return String(text).replace(/\{([^}]+)\}/g, (_, inside) => {
      const raw = String(inside).trim();
      if (!raw) return "";

      const [keyRaw, fallbackRaw] = raw.split("|").map((s) => (s || "").trim());
      const key = keyRaw;
      const fallback = fallbackRaw || "";

      const value = getParamValue(key);
      const finalValue = value ? value : fallback;

      return escapeHtml(finalValue);
    });
  };

  document.querySelectorAll(tokenizeSelector).forEach((el) => {
    // Only replace text content (safe + predictable)
    const original = el.textContent;
    const replaced = replaceTokens(original);
    el.textContent = replaced;
  });
});
</script>
