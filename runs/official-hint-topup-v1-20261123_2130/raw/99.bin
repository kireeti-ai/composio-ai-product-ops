h="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-column w-4 h-4 flex-shrink-0"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg><span class="text-xs md:text-sm">Powering 15M+ transcripts every month</span></div></div></div></div><div class="xl:col-span-6"><div class="aspect-video"><div class="w-full h-full"><video class="w-full object-cover rounded-lg h-full" poster="/assets/youtube-transcript-api-demo-poster-BNQyVM56.webp" preload="metadata" autoplay="" playsinline="" fetchpriority="high" loop="" aria-label="Demo showing YouTube Transcript extraction using Transcript API."><source src="/assets/youtube-transcript-api-demo-1600-BGvl_jc-.webm" type="video/webm" media="(min-width: 1280px)" data-width="1600" data-height="900"><source src="/assets/youtube-transcript-api-demo-1600-CE8N4fQm.mp4" type="video/mp4" media="(min-width: 1280px)" data-width="1600" data-height="900" data-bitrate="746"><source src="/assets/youtube-transcript-api-demo-1280-sJX6rXQV.webm" type="video/webm" media="(min-width: 768px)" data-width="1280" data-height="720"><source src="/assets/youtube-transcript-api-demo-1280-BcW6dQA4.mp4" type="video/mp4" media="(min-width: 768px)" data-width="1280" data-height="720" data-bitrate="504"><source src="/assets/youtube-transcript-api-demo-960-D8eKtNrV.webm" type="video/webm" media="(min-width: 480px)" data-width="960" data-height="540"><source src="/assets/youtube-transcript-api-demo-960-jinfXsZK.mp4" type="video/mp4" media="(min-width: 480px)" data-width="960" data-height="540" data-bitrate="271"><source src="/assets/youtube-transcript-api-demo-640-DCmvphCO.webm" type="video/webm" data-width="640" data-height="360"><source src="/assets/youtube-transcript-api-demo-640-C5fEmjcI.mp4" type="video/mp4" data-width="640" data-height="360" data-bitrate="150">Your browser does not support the video tag.</video></div></div></div></div></section><section class="container mx-auto px-4 py-12 md:py-16"><div class="space-y-3 text-center"><div class="text-sm font-medium text-primary uppercase tracking-wider">Trusted in production</div><h2 class="text-3xl md:text-4xl font-bold">500K+ Transcripts Processed Daily</h2><p class="text-lg text-muted-foreground max-w-2xl mx-auto">49ms median response time. 15M+ transcripts served last month.</p></div><div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4"><a href="https://youtubetotranscript.com" target="_blank" rel="noreferrer" class="group relative block overflow-hidden rounded-lg border border-border bg-gradient-to-br from-surface-2 to-surface-1 p-6 transition-all hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10 hover:-translate-y-1"><div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/10 to-transparent rounded-bl-full opacity-50 group-hover:opacity-100 transition-opacity"></div><div class="relative z-10"><div class="mb-4"><div class="flex items-center gap-2"><h3 class="font-semibold text-lg group-hover:text-primary transition-colors">youtubetotranscript.com</h3><span class="text-success"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></span></div><div class="text-xs text-muted-foreground mt-1">Verified Production User</div></div><div class="bg-surface-3 rounded-md p-4"><div class="flex items-center justify-between"><div><div class="text-2xl font-bold text-primary">~11M</div><div class="text-xs text-muted-foreground mt-1">transcripts per month</div></div><div class="flex items-center gap-1 text-success"><span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up" aria-hidden="true" focusable="false"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg></span><span class="text-xs font-medium">Active</span></div></div></div></div></a><a href="https://recapio.com" target="_blank" rel="noreferrer" class="group relative block overflow-hidden rounded-lg border border-border bg-gradient-to-br from-surface-2 to-surface-1 p-6 transition-all hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10 hover:-translate-y-1"><div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/10 to-transparent rounded-bl-full opacity-50 group-hover:opacity-100 transition-opacity"></div><div class="relative z-10"><div class="mb-4"><div class="flex items-center gap-2"><h3 class="font-semibold text-lg group-hover:text-primary transition-colors">recapio.com</h3><span class="text-success"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></span></div><div class="text-xs text-muted-foreground mt-1">Verified Production User</div></div><div class="bg-surface-3 rounded-md p-4"><div class="flex items-center justify-between"><div><div class="text-2xl font-bold text-primary">~2.8M</div><div class="text-xs text-muted-foreground mt-1">transcripts per month</div></div><div class="flex items-center gap-1 text-success"><span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up" aria-hidden="true" focusable="false"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg></span><span class="text-xs font-medium">Active</span></div></div></div></div></a></div></section><section id="features" tabindex="-1" aria-label="Features" class="container mx-auto px-4 py-12 md:py-16 scroll-mt-24 outline-none"><div class="space-y-3 text-center"><div class="text-sm font-medium text-primary uppercase tracking-wider">Everything you need from YouTube</div><h2 class="text-3xl md:text-4xl font-bold">One API. Full YouTube Access.</h2><p class="text-lg text-muted-foreground max-w-2xl mx-auto">Transcripts, search, channels, playlists — all in one place. Every feature works via API, MCP, and agent skills.</p></div><div class="mt-12 space-y-6"><div class="group relative"><div class="absolute -inset-px rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500 pointer-events-none bg-gradient-to-r from-primary/20 via-primary/10 to-transparent"></div><div class="relative rounded-2xl p-px transition-all duration-500 bg-gradient-to-br from-white/[0.08] via-white/[0.03] to-transparent group-hover:from-primary/30 group-hover:via-primary/10 group-hover:to-transparent"><div class="relative rounded-[calc(1rem-1px)] bg-surface-2 p-6 md:p-8 overflow-hidden"><div class="absolute -top-24 -left-24 w-64 h-64 rounded-full blur-3xl pointer-events-none transition-opacity duration-500 bg-primary/[0.04] group-hover:bg-primary/[0.08]"></div><div class="relative"><div class="flex flex-wrap items-center gap-3 mb-3"><h3 class="text-xl md:text-2xl font-semibold tracking-tight">Get Transcripts</h3><span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium tracking-wide bg-primary/10 text-primary ring-1 ring-primary/20">1 credit</span></div><p class="text-muted-foreground leading-relaxed max-w-2xl mb-4">Extract transcripts from any YouTube video — with or without timestamps. Drop the output straight into summarizers, search indexes, or AI pipelines.</p><div class="flex flex-wrap gap-2 mb-6"><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Summarize videos</span><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Study notes</span><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Search indexes</span><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Content repurposing</span></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-4"><div class="rounded-lg border border-white/[0.06] overflow-hidden h-full flex flex-col"><div class="flex-1"><div class="flex items-center justify-between px-3 py-1.5 bg-white/[0.03] border-b border-white/[0.06]"><span class="text-[10px] uppercase tracking-wider text-muted-foreground/50 font-medium">Request</span><button type="button" class="inline-flex items-center gap-1.5 text-[11px] text-muted-foreground hover:text-foreground transition-colors shrink-0" aria-label="Copy curl"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy w-3 h-3"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg> Copy</button></div><div class="p-3 bg-surface-3/50"><pre class="text-xs font-mono leading-relaxed whitespace-pre-wrap break-all"><span class="text-emerald-400 font-semibold">curl</span> "<span class="text-amber-300/80">https://transcriptapi.com/api/v2/youtube/transcript?video_url=dQw4w9WgXcQ&amp;format=json</span>" \
  <span class="text-sky-400">-H</span> "<span class="text-amber-300/80">Authorization: Bearer API_KEY</span>"</pre></div></div><div class="flex-1"><div class="flex items-center px-3 py-1.5 bg-white/[0.03] border-t border-b border-white/[0.06]"><span class="text-[10px] uppercase tracking-wider text-muted-foreground/50 font-medium">Response</span></div><div class="p-3 bg-surface-3/30"><pre class="text-xs font-mono leading-relaxed whitespace-pre-wrap break-all">{
  "<span class="text-sky-300/80">language</span>": "<span class="text-amber-300/70">en</span>",
  "<span class="text-sky-300/80">length_seconds</span>": <span class="text-emerald-400/80">1164</span>,
  "<span class="text-sky-300/80">lengthText</span>": "<span class="text-amber-300/70">19:24</span>",
  "<span class="text-sky-300/80">metadata</span>": {
    "<span class="text-sky-300/80">title</span>": "<span class="text-amber-300/70">Do schools kill creativity?</span>"
  },
  "<span class="text-sky-300/80">transcript</span>": [
    {
      "<span class="text-sky-300/80">text</span>": "<span class="text-amber-300/70">Good morning. How are you?</span>",
      "<span class="text-sky-300/80">start</span>": <span class="text-emerald-400/80">0.0</span>,
      "<span class="text-sky-300/80">duration</span>": <span class="text-emerald-400/80">3.2</span>
    },
    {
      "<span class="text-sky-300/80">text</span>": "<span class="text-amber-300/70">It's been great, hasn't it?</span>",
      "<span class="text-sky-300/80">start</span>": <span class="text-emerald-400/80">3.2</span>,
      "<span class="text-sky-300/80">duration</span>": <span class="text-emerald-400/80">2.9</span>
    }
  ]
}</pre></div></div></div><div class="rounded-lg border border-white/[0.06] overflow-hidden h-full flex flex-col"><div class="flex items-center justify-between px-3 py-1.5 bg-white/[0.03] border-b border-white/[0.06]"><div class="flex items-center gap-1.5"><img src="data:image/svg+xml,%3csvg%20xmlns='http://www.w3.org/2000/svg'%20shape-rendering='geometricPrecision'%20text-rendering='geometricPrecision'%20image-rendering='optimizeQuality'%20fill-rule='evenodd'%20clip-rule='evenodd'%20viewBox='0%200%20512%20509.639'%3e%3cpath%20fill='%23fff'%20d='M115.612%200h280.775C459.974%200%20512%2052.026%20512%20115.612v278.415c0%2063.587-52.026%20115.613-115.613%20115.613H115.612C52.026%20509.64%200%20457.614%200%20394.027V115.612C0%2052.026%2052.026%200%20115.612%200z'/%3e%3cpath%20fill-rule='nonzero'%20d='M412.037%20221.764a90.834%2090.834%200%20004.648-28.67%2090.79%2090.79%200%2000-12.443-45.87c-16.37-28.496-46.738-46.089-79.605-46.089-6.466%200-12.943.683-19.264%202.04a90.765%2090.765%200%2000-67.881-30.515h-.576c-.059.002-.149.002-.216.002-39.807%200-75.108%2025.686-87.346%2063.554-25.626%205.239-47.748%2021.31-60.682%2044.03a91.873%2091.873%200%2000-12.407%2046.077%2091.833%2091.833%200%200023.694%2061.553%2090.802%2090.802%200%2000-4.649%2028.67%2090.804%2090.804%200%200012.442%2045.87c16.369%2028.504%2046.74%2046.087%2079.61%2046.087a91.81%2091.81%200%200019.253-2.04%2090.783%2090.783%200%200067.887%2030.516h.576l.234-.001c39.829%200%2075.119-25.686%2087.357-63.588%2025.626-5.242%2047.748-21.312%2060.682-44.033a91.718%2091.718%200%200012.383-46.035%2091.83%2091.83%200%2000-23.693-61.553l-.004-.005zM275.102%20413.161h-.094a68.146%2068.146%200%2001-43.611-15.8%2056.936%2056.936%200%20002.155-1.221l72.54-41.901a11.799%2011.799%200%20005.962-10.251V241.651l30.661%2017.704c.326.163.55.479.596.84v84.693c-.042%2037.653-30.554%2068.198-68.21%2068.273h.001zm-146.689-62.649a68.128%2068.128%200%2001-9.152-34.085c0-3.904.341-7.817%201.005-11.663.539.323%201.48.897%202.155%201.285l