.swiper-pagination {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center !important;
  align-items: center !important;
  bottom: auto !important;
}

.swiper-pagination-bullet {
  background: #FFF58C !important;
  opacity: 0.4;
  padding: 6px;
  margin: 10px !important;
}

.swiper-pagination-bullet-active {
  opacity: 1;
}
.swiper-pagination {
	position: relative !important;
}
</style>

<script>
(function () {
  function initHomeSliders() {
    const isMobile = window.matchMedia("(max-width: 991px)").matches;

    document.querySelectorAll(".home-slider-wrapper").forEach(function (wrap) {
      const swiperEl = wrap.querySelector(".swiper");
      if (!swiperEl) return;
      const slides = swiperEl.querySelectorAll(".swiper-slide");
      const navWrap = wrap.querySelector(".slider-navigation-wrapper");
      if (slides.length <= 1) {
        if (navWrap) navWrap.style.display = "none";
        return;
      } else {
        if (navWrap) navWrap.style.display = "";
      }
      const slider = new Swiper(swiperEl, {
        slidesPerView: 'auto',
        centeredSlides: true,
        initialSlide: 0,
        spaceBetween: 95,
        speed: 600,
        allowTouchMove: true,
        grabCursor: true,
        navigation: {
          nextEl: wrap.querySelector(".swiper-next"),
          prevEl: wrap.querySelector(".swiper-prev")
        },
        pagination: {
          el: wrap.querySelector(".swiper-pagination"),
          type: 'bullets',
          clickable: true
        },
        breakpoints: {
          992: { spaceBetween: 95 },
          0: { spaceBetween: 40 }
        }
      });
      if (isMobile) {
        slider.updateAutoHeight(0);
        setTimeout(function () { slider.updateAutoHeight(0); }, 200);
      }
    });
  }

  function whenReady() {
    if (typeof Swiper !== "undefined") {
      initHomeSliders();
      return;
    }
    // Global Swiper 11 bundle hasn't loaded yet: poll until it's available
    let tries = 0;
    const timer = setInterval(function () {
      if (typeof Swiper !== "undefined") {
        clearInterval(timer);
        initHomeSliders();
      } else if (++tries > 100) { // ~5s safety cap
        clearInterval(timer);
        console.warn("Swiper never loaded. Check the global v11 script in the footer.");
      }
    }, 50);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", whenReady);
  } else {
    whenReady();
  }
})();
</script></div><div class="code-embed w-embed"><style>
/* 1) Base slide styling */
.home-slider-full .home-slider {
  flex: 0 0 auto;
  width: 100%;         
  max-width: 53rem;
  margin: 0 auto;
  border-radius: 0.5rem;
  overflow: hidden;
}

/* 2) Layout & peeking */
.home-slider-full .swiper,
.home-slider-full .swiper-wrapper {
  overflow: visible !important;  
  display: flex;
  align-items: center;
}

/* 3) Desktop: right peek + left mask */
.home-slider-full .swiper {
  padding: 0 4rem 0 0;
}

/* 4) Mobile adjustments - proper centering */
@media (max-width: 991px) {
  .home-slider-full .swiper {
    padding: 0 2rem;              /* Equal padding on both sides for centering */
  }
  
  .home-slider-full .home-slider {
    max-width: 90vw;              /* Adjust width for smaller screens */
  }
}

@media (max-width: 767px) {
  .home-slider-full .swiper {
    padding: 0 1rem;              /* Smaller padding on mobile */
  }
  
  .home-slider-full .home-slider {
    max-width: 85vw;              /* Even smaller on phones */
  }
}
.image-wrapper{
	border-radius: 0px !important;
}
</style></div><div class="swiper-gradient-bg"><div class="hide w-embed w-script"><script>
