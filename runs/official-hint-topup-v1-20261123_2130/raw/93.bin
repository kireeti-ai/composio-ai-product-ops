              .testimonial_item:nth-child(4n + 1) { background-color: var(--base-color-brand--yellow); }
              .testimonial_item:nth-child(4n + 2) { background-color: var(--base-color-brand--purple); }
              .testimonial_item:nth-child(4n + 3) { background-color: var(--base-color-brand--pink); }
              .testimonial_item:nth-child(4n + 4) { background-color: var(--base-color-brand--orange); }

              /* --- Bottom banner positioning --- */
              [data-banner="wrapper"][data-banner-position="bottom"]{
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                width: 100%;
                z-index: 9999;
              }

              /* --- Bottom banner animation direction overrides --- */
              /* Hidden / closing state should move DOWN (not up) */
              [data-banner="wrapper"][data-banner-position="bottom"]{
                transform: translateY(12px);
              }

              /* Visible state sits at 0 */
              html.bannerAllowed
                [data-banner="wrapper"][data-banner-position="bottom"].isBannerVisible{
                transform: translateY(0);
              }

              /* If dismissed, ensure it closes downward too */
              html.bannerDismissed
                [data-banner="wrapper"][data-banner-position="bottom"]{
                transform: translateY(12px) !important;
              }

              /* Optional: avoid iOS home indicator overlap */
              @supports (padding: env(safe-area-inset-bottom)) {
                [data-banner="wrapper"][data-banner-position="bottom"]{
                  padding-bottom: env(safe-area-inset-bottom);
                }
              }

              /* Make text look crisper and more legible in all browsers */
              body {
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
              }

              /* Focus state style for keyboard navigation for the focusable elements */
              *[tabindex]:focus-visible,
                input[type="file"]:focus-visible {
                 outline: 0.125rem solid #4d65ff;
                 outline-offset: 0.125rem;
              }

              /* Set color style to inherit */
              .inherit-color * {
                  color: inherit;
              }

              /* Get rid of top margin on first element in any rich text element */
              .w-richtext > :not(div):first-child, .w-richtext > div:first-child > :first-child {
                margin-top: 0 !important;
              }

              /* Get rid of bottom margin on last element in any rich text element */
              .w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {
              	margin-bottom: 0 !important;
              }


              /* Make sure containers never lose their center alignment */
              .container-medium,.container-small, .container-large {
              	margin-right: auto !important;
                margin-left: auto !important;
              }

              /*
              Make the following elements inherit typography styles from the parent and not have hardcoded values.
              Important: You will not be able to style for example "All Links" in Designer with this CSS applied.
              Uncomment this CSS to use it in the project. Leave this message for future hand-off.
              */
              /*
              a,
              .w-input,
              .w-select,
              .w-tab-link,
              .w-nav-link,
              .w-dropdown-btn,
              .w-dropdown-toggle,
              .w-dropdown-link {
                color: inherit;
                text-decoration: inherit;
                font-size: inherit;
              }
              */

              /* Apply "..." after 3 lines of text */
              .text-style-3lines {
              	display: -webkit-box;
              	overflow: hidden;
              	-webkit-line-clamp: 3;
              	-webkit-box-orient: vertical;
              }

              /* Apply "..." after 2 lines of text */
              .text-style-2lines {
              	display: -webkit-box;
              	overflow: hidden;
              	-webkit-line-clamp: 2;
              	-webkit-box-orient: vertical;
              }

              /* Adds inline flex display */
              .display-inlineflex {
                display: inline-flex;
              }

              /* These classes are never overwritten */
              .hide {
                display: none !important;
              }

              @media screen and (max-width: 991px) {
                  .hide, .hide-tablet {
                      display: none !important;
                  }
              }
                @media screen and (max-width: 767px) {
                  .hide-mobile-landscape{
                    display: none !important;
                  }
              }
                @media screen and (max-width: 479px) {
                  .hide-mobile{
                    display: none !important;
                  }
              }

              .margin-0 {
                margin: 0rem !important;
              }

              .padding-0 {
                padding: 0rem !important;
              }

              .spacing-clean {
              padding: 0rem !important;
              margin: 0rem !important;
              }

              .margin-top {
                margin-right: 0rem !important;
                margin-bottom: 0rem !important;
                margin-left: 0rem !important;
              }

              .padding-top {
                padding-right: 0rem !important;
                padding-bottom: 0rem !important;
                padding-left: 0rem !important;
              }

              .margin-right {
                margin-top: 0rem !important;
                margin-bottom: 0rem !important;
                margin-left: 0rem !important;
              }

              .padding-right {
                padding-top: 0rem !important;
                padding-bottom: 0rem !important;
                padding-left: 0rem !important;
              }

              .margin-bottom {
                margin-top: 0rem !important;
                margin-right: 0rem !important;
                margin-left: 0rem !important;
              }

              .padding-bottom {
                padding-top: 0rem !important;
                padding-right: 0rem !important;
                padding-left: 0rem !important;
              }

              .margin-left {
                margin-top: 0rem !important;
                margin-right: 0rem !important;
                margin-bottom: 0rem !important;
              }

              .padding-left {
                padding-top: 0rem !important;
                padding-right: 0rem !important;
                padding-bottom: 0rem !important;
              }

              .margin-horizontal {
                margin-top: 0rem !important;
                margin-bottom: 0rem !important;
              }

              .padding-horizontal {
                padding-top: 0rem !important;
                padding-bottom: 0rem !important;
              }

              .margin-vertical {
                margin-right: 0rem !important;
                margin-left: 0rem !important;
              }

              .padding-vertical {
                padding-right: 0rem !important;
                padding-left: 0rem !important;
              }

              [data-wf--rich-text-block--variant="medium"],
              [data-wf--rich-text-block--variant="medium"] p {
                  font-size: var(--p-medium) !important;
              }

              [data-wf--rich-text-block--variant="regular"],
              [data-wf--rich-text-block--variant="regular"] p {
                  font-size: var(--p-regular) !important;
              }
              /*ENSURE SECTION WITH STARS EFFECT IS ALWAYS RELATIVE*/

              [data-anim="stars"] {
              	position: relative !important;
              }

              /* BUTTON GRADIENT EFFECT */

              .button-gradient {
                position: absolute;
                inset: -1px;
                border-radius: inherit;
                pointer-events: none;
                width: 220%;
                left: -60% !important;
                transform: translateX(-55%);
                transition: transform 2s cubic-bezier(.2,.8,.2,1);
                will-change: transform;
              }
              .button:hover .button-gradient,
              .button:focus-visible .button-gradient-blue{
                transform: translateX(55%);
              }
              /* GLASSMORPHISM BORDER EFFECT*/

              .glass_wrapper.logos, .work_slide, .stats_card::before {
                position: relative;
                background: hsl(from var(--base-color-brand--black) h s l / 0.1);
                backdrop-filter: blur(12px) !important;
              }

              .glass_wrapper.logos::before, .work_slide::before, .pricing_card-wrapper.team::before, [data-border="gradient"]::before {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: inherit;
                border: 1px solid transparent;
                background: linear-gradient(354deg, var(--base-color-brand--black) 3%, #ffffff3d 51%, var(--base-color-brand--black) 97%, var(--base-color-brand--black) 103%) border-box;
                mask: linear-gradient(black, black) border-box,
                  linear-gradient(black, black) padding-box;
                mask-composite: subtract;
              }

              [data-border="gradient-popup"]::before {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: inherit;
                border: 3px solid transparent;
                background: linear-gradient(354deg, var(--base-color-brand--black) 3%, #ffffff3d 51%, var(--base-color-brand--black) 97%, var(--base-color-brand--black) 103%) border-box;
                mask: linear-gradient(black, black) border-box,
                  linear-gradient(black, black) padding-box;
                mask-composite: subtract;
              }

              .stats_card::before, [data-border="pink"]::before,
              [data-border="orange"]::before,
      			[data-border="orange-mag"]::before,
                [data-border="blue"]::before,
              [data-border="yellow"]::before,
      [data-border="yellow-purple"]::before,
      			[data-border="mag-purple"]::before,
              [data-border="purple"]::before {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: inherit;
                border: 2px solid transparent;
                background: linear-gradient(354deg, var(--base-color-brand--black) 3%, #ffffff3d 51%, var(--base-color-brand--black) 97%, var(--base-color-brand--black) 103%) border-box;
                mask: linear-gradient(black, black) border-box,
                  linear-gradient(black, black) padding-box;
                mask-composite: subtract;
              }
                [data-border="orange-bottom"]::before, .case-study_card::before {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: inherit;
                border: 1px solid transparent;
                background: linear-gradient(354deg, var(--base-color-brand--black) 3%, #ffffff3d 51%, var(--base-color-brand--black) 97%, var(--base-color-brand--black) 103%) border-box;
                mask: linear-gradient(black, black) border-box,
                  linear-gradient(black, black) padding-box;
                mask-composite: subtract;
              }

              [data-border="pink"]::before {
                background: linear-gradient(90deg, var(--base-color-brand--pink) 0%, var(--base-color-brand--orange) 100%) border-box;
                z-index: 1;
              }
              [data-border="orange"]::before {
                background: linear-gradient(90deg, var(--base-color-brand--orange) 0%, var(--base-color-brand--yellow) 100%) border-box;
                z-index: 1;
              }
    [data-border="orange-mag"]::before {
      background: linear-gradient(
        90deg,
        var(--base-color-brand--orange) 0%,
        #C62A7D 100%
      ) border-box;
      z-index: 1;
    }
                [data-border="orange-bottom"]::before {
                background: linear-gradient(0deg, var(--base-color-brand--orange) 0%, var(--base-color-brand--yellow) 100%) border-box;
                z-index: 1;
              }
                 [data-border="blue"]::before {
                background: linear-gradient(0deg, var(--base-color-brand--cyan) 0%, #007299 100%) border-box;
                z-index: 1;
              }
              [data-border="yellow"]::before {
                background: linear-gradient(90deg, var(--base-color-brand--yellow) 0%, var(--base-color-brand--purple) 100%) border-box;
                z-index: 1;
              }
                [data-border="yellow-purple"]::before {
                background: linear-gradient(90deg, var(--base-color-brand--purple) 0%, var(--base-color-brand--yellow) 100%) border-box;
                z-index: 1;
              }
              [data-border="purple"]::before {
                background: linear-gradient(90deg, var(--base-color-brand--purple) 0%, var(--base-color-brand--pink) 100%) border-box;
                z-index: 1;
              }
    [data-border="mag-purple"]::before {
      background: linear-gradient(
        90deg,
        #C62A7D 0%,
        var(--base-color-brand--purple) 100%
      ) border-box;
      z-index: 1;
    }
              .stats_card[data-border="pink-purple"]::before {
                background: linear-gradient(180deg, var(--base-color-brand--pink) 0%, var(--base-color-brand--purple) 100%) border-box;
                z-index: 1;
              }
              .stats_card[data-border="purple-yellow"]::before {
                background: linear-gradient(180deg, var(--base-color-brand--purple) 0%, var(--base-color-brand--yellow) 100%) border-box;
                z-index: 1;
              }
              .glass_wrapper.logos::before {
                background: linear-gradient(354deg, var(--base-color-brand--black) 3%, #ffffff3d 51%, var(--base-color-brand--black) 97%, var(--base-color-brand--black) 103%) border-box;
                z-index: -1;
              }

              .work_slide::before, .pricing_card-wrapper.team::before, [data-border="gradient"]::before, [data-border="gradient-popup"]::before {
                background: linear-gradient(90deg, var(--base-color-brand--yellow), var(--base-color-brand--pink) 27%, var(--base-color-brand--purple) 53%, var(--base-color-brand--orange) 79%, var(--base-color-brand--pink)) border-box;
                z-index: 1;
              }
              .case-list.w-dyn-items > .w-dyn-item:nth-child(1) .case-study_card::before {
                background: linear-gradient(90deg, var(--base-color-brand--yellow) 0%, var(--base-color-brand--purple) 100%) border-box;
              }
              .case-list.w-dyn-items > .w-dyn-item:nth-child(2) .case-study_card::before {
                background: linear-gradient(90deg, var(--base-color-brand--purple) 0%, var(--base-color-brand--orange) 100%) border-box;
              }
              .case-list.w-dyn-items > .w-dyn-item:nth-child(3) .case-study_card::before {
                background: linear-gradient(90deg, var(--base-color-brand--orange) 0%, var(--base-color-brand--pink) 100%) border-box;
              }
              /* Vignette around background grid*/
              .overlay_wrapper::after {
                content: "";
                position: absolute;
                inset: 0; /* cover the whole grid */
                pointer-events: none; /* don’t block clicks */
                background: radial-gradient(
                  circle,
                  rgba(0,0,0,0) 70%,
                  rgba(0,0,0,0.7) 100%
                );
              }

              /* MOBILE MENU HAMBURGER */

              .hamburger_wrap {
              	--thickness: 0.2rem;
              	--gap: 0.5rem;
              	--rotate: 45;
                --width: 90%;
              }
              .w--open .hamburger_line:first-child {
              	transform: translateY(calc(var(--thickness) * 0.5 + var(--gap) * 0.5)) rotate(calc(var(--rotate) * -1deg));
              }
              .w--open .hamburger_line:last-child {
              	transform: translateY(calc(var(--thickness) * -0.5  + var(--gap) * -0.5)) rotate(calc(var(--rotate) * 1deg));
              }
              .w--open .hamburger_wrap:hover {
              	--width: 90%;
              }

              /* PRODUCT CARDS COMPONENT */

              .product-image_border::before {
                content: "";
                position: absolute;
                z-index: -1;
                inset: 0;
                border: 3rem solid transparent;
              }
              strong {
              font-weight: 500 !important;
              }
              [content-image="yellow"] {
                  background: linear-gradient(180deg, var(--base-color-brand--yellow) 0%, var(--base-color-brand--orange) 100%) border-box;
              }
              [content-image="orange"] {
                  background: linear-gradient(180deg, var(--base-color-brand--orange) 0%, var(--base-color-brand--pink) 100%) border-box;
              }
              [content-image="pink"] {
                  background: linear-gradient(180deg, var(--base-color-brand--pink) 0%, var(--base-color-brand--purple) 100%) border-box;
              }
              [content-grid="left"] {
                  flex-flow: row-reverse;
              }
              .flex-comp:has([image-visibility="hide"]) {
                  display: flex;
                  flex-direction: column !important;
                  width: 100% !important;
              }
              [data-text-size="regular"] {
               font-size: var(--p-regular);
              }
              [data-text-size="large"] {
              	font-size: var(--p-large);
              }

              [image-visibility="hide"] ~ .meet_content-wrapper {
                  max-width: 80%;
                  align-items: center;
              }
              [image-visibility="hide"] ~ .meet_content-wrapper p, [image-visibility="hide"] ~ .meet_content-wrapper .heading-card {
                  text-align: center !important;
              }
              [image-visibility="hide"] {
                  display: none;
              }


              /*[card-height="tall"] {
                  min-height: 26.75rem;
              }*/

              [card-height="tall"] {
                  min-height: auto;
              }

              [card-height="short"] {
                  min-height: auto;
              }
              [card-content-layout="side"] {
                display: grid;
                flex-flow: column;
                justify-content: flex-start;
                align-items: flex-start;
                grid-auto-columns: 1fr;
                gap: 4rem;
                place-items: end;
                grid-template-columns: auto minmax(auto, 1fr);
                grid-template-rows: auto;
              }

              /* SLIDER ATTRIBUTES TRUE OR FALSE */

              [data-slider="true"] {
              	display: block !important;
              }
              [data-slider="false"], .grid-auto {
              display: grid !important;
              gap: 1.5rem;
              grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
              max-width: 100%;
              }
              [data-slider-arrows="true"] {
                display: flex;
              }
              [data-slider-arrows="false"] {
                display: none;
              }

              @media (max-width: 991px) {
              [content-grid="left"] {
                  flex-flow: column;
              }

              [card-height="short"], [card-height="tall"] {
                  min-height: auto !important;
              }
              [card-content-layout="side"] {
                display: flex;
                flex-flow: column;
                align-content: flex-start;
              }
              [data-slider="false"], .grid-auto {
              display: grid !important;
              gap: 1.5rem;
              grid-template-columns: 1fr;
              max-width: 100%;
              }
              }
              @media (min-width: 1024px) and (max-width: 1366px) {
                  .circle_wrapper {
                      height: 100%;
                      max-height: 70%;
                  }
                      .gradient_pink-purple.clarity {
                      height: 100%;
                      max-height: 70%;
                  }
              }

     /* Viewport for both modes */
    [data-banner-mode],
    [data-banner-marquee="true"] {
      overflow: hidden;
      position: relative;
    }

    /* ============================================
       BANNER: marquee
       ============================================ */

    [data-banner-mode="marquee"] .bannerMarqueeTrack,
    [data-banner-marquee="true"] .bannerMarqueeTrack {
      display: flex;
      width: max-content;
      will-change: transform;
      animation-name: bannerMarqueeScroll;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-duration: var(--bannerMarqueeDuration, 20s);
    }

    [data-banner-mode="marquee"] .bannerMarqueeItem,
    [data-banner-marquee="true"] .bannerMarqueeItem {
      flex: 0 0 auto;
      white-space: nowrap;
      /* Applied to EVERY item, including the last.
         The trailing gap is part of the measured loop distance. */
      margin-right: var(--bannerMarqueeGap, 24px);
    }

    /* Opt-in pause on hover: data-banner-pause-hover="true" */
    [data-banner-pause-hover="true"]:hover .bannerMarqueeTrack {
      animation-play-state: paused;
    }

    @keyframes bannerMarqueeScroll {
      from { transform: translate3d(0, 0, 0); }
      to   { transform: translate3d(calc(-1 * var(--bannerMarqueeDistance, 0px)), 0, 0); }
    }

    /* ============================================
       BANNER: slider
       ============================================ */

    [data-banner-mode="slider"] .bannerSliderTrack {
      display: flex;
      flex-wrap: nowrap;
      width: 100%;
      will-change: transform;
      transition-property: transform;
      transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
      transition-duration: 0ms;
    }

    [data-banner-mode="slider"] .bannerSliderItem {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      /* No margin here: slides are exactly 100% of the viewport */
    }

    /* ============================================
       BANNER: static
       ============================================ */

    [data-banner-active-mode="static"] [data-banner="content"]:not(:first-child) {
      display: none;
    }

    /* ============================================
       BANNER: reduced motion
       ============================================ */

    @media (prefers-reduced-motion: reduce) {
      .bannerMarqueeTrack { animation: none; }
      .bannerSliderTrack  { transition-duration: 0ms !important; }
    }

    /* ============================================
       Unrelated: pricing CTA gradient border
       (move this to your pricing styles)
       ============================================ */

    .pricing_cta-block::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(90deg, #FFA8BB 0%, #F55200 34.13%, #9600FF 66.83%, #FFF58C 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }
              .anchor{
                top: -88px;     /* = sticky nav height */
                height: 0;
              }

              /* Large default */
              .slot[data-large-columns="1"] { --_column-count---value: 1; }
              .slot[data-large-columns="2"] { --_column-count---value: 2; }
              .slot[data-large-columns="3"] { --_column-count---value: 3; }
              .slot[data-large-columns="4"] { --_column-count---value: 4; }
              .slot[data-large-columns="5"] { --_column-count---value: 5; }
              .slot[data-large-columns="6"] { --_column-count---value: 6; }
              .slot[data-large-columns="7"] { --_column-count---value: 7; }
              .slot[data-large-columns="8"] { --_column-count---value: 8; }
              .slot[data-large-columns="9"] { --_column-count---value: 9; }
              .slot[data-large-columns="10"] { --_column-count---value: 10; }
              .slot[data-large-columns="11"] { --_column-count---value: 11; }
              .slot[data-large-columns="12"] { --_column-count---value: 12; }

              /* Tablet */
              @media screen and (max-width: 991px) {
                .slot[data-medium-columns="1"] { --_column-count---value: 1; }
                .slot[data-medium-columns="2"] { --_column-count---value: 2; }
                .slot[data-medium-columns="3"] { --_column-count---value: 3; }
                .slot[data-medium-columns="4"] { --_column-count---value: 4; }
                .slot[data-medium-columns="5"] { --_column-count---value: 5; }
                .slot[data-medium-columns="6"] { --_column-count---value: 6; }
                .slot[data-medium-columns="7"] { --_column-count---value: 7; }
                .slot[data-medium-columns="8"] { --_column-count---value: 8; }
                .slot[data-medium-columns="9"] { --_column-count---value: 9; }
                .slot[data-medium-columns="10"] { --_column-count---value: 10; }
                .slot[data-medium-columns="11"] { --_column-count---value: 11; }
                .slot[data-medium-columns="12"] { --_column-count---value: 12; }
              }

              /* Mobile landscape */
              @media screen and (max-width: 767px) {
                .slot[data-small-columns="1"] { --_column-count---value: 1; }
                .slot[data-small-columns="2"] { --_column-count---value: 2; }
                .slot[data-small-columns="3"] { --_column-count---value: 3; }
                .slot[data-small-columns="4"] { --_column-count---value: 4; }
                .slot[data-small-columns="5"] { --_column-count---value: 5; }
                .slot[data-small-columns="6"] { --_column-count---value: 6; }
                .slot[data-small-columns="7"] { --_column-count---value: 7; }
                .slot[data-small-columns="8"] { --_column-count---value: 8; }
                .slot[data-small-columns="9"] { --_column-count---value: 9; }
                .slot[data-small-columns="10"] { --_column-count---value: 10; }
                .slot[data-small-columns="11"] { --_column-count---value: 11; }
                .slot[data-small-columns="12"] { --_column-count---value: 12; }
              }

              /* Mobile portrait */
              @media screen and (max-width: 479px) {
                .slot[data-xsmall-columns="1"] { --_column-count---value: 1; }
                .slot[data-xsmall-columns="2"] { --_column-count---value: 2; }
                .slot[data-xsmall-columns="3"] { --_column-count---value: 3; }
                .slot[data-xsmall-columns="4"] { --_column-count---value: 4; }
                .slot[data-xsmall-columns="5"] { --_column-count---value: 5; }
                .slot[data-xsmall-columns="6"] { --_column-count---value: 6; }
                .slot[data-xsmall-columns="7"] { --_column-count---value: 7; }
                .slot[data-xsmall-columns="8"] { --_column-count---value: 8; }
                .slot[data-xsmall-columns="9"] { --_column-count---value: 9; }
                .slot[data-xsmall-columns="10"] { --_column-count---value: 10; }
                .slot[data-xsmall-columns="11"] { --_column-count---value: 11; }
                .slot[data-xsmall-columns="12"] { --_column-count---value: 12; }
              }
              [data-boxed="True"] {
                  padding: var(--padding-boxed);
                  border-radius: 1.5rem;
              }

              [data-grid1], [data-grid2] {
                  position: absolute;
              }

              [data-grid1="top-left"], [data-grid2="top-left"] {
                  top: 0
                  left: 0;
              }
              [data-grid1="top-right"], [data-grid2="top-right"]{
                  top: 0;
                  right: -8%;
              }

              [data-grid1="bottom-right"], [data-grid2="bottom-right"]{
                  bottom: 0%;
                  right: -8%;
              }

              [data-grid1="bottom-left"], [data-grid2="bottom-left"] {
                  bottom: 0%;
                  left: -8%;
              }
              .overflow-visible {
              overflow: visible !important;
              }
              /* grid / flex child containing the slider MUST be allowed to shrink */
              .testimonial-wrapper {
                min-width: 0;
              }

              /* ensure swiper itself can size correctly */
              .testimonial-wrapper .swiper {
                width: 100%;
                min-width: 0;
                overflow: hidden !important;
              }

              /* swiper sometimes inherits weird stuff in Webflow */
              .testimonial-wrapper .swiper-slide {
                width: 100%;
              }

              [data-wf--section--variant="light"] .arrow-bg {
                  color: var(--base-color-brand--black);
              }
              [data-wf--section--variant="light"] .arrow-color {
                  color: var(--base-color-brand--yellow);
              }

              [data-wf--section--variant="dark"] .arrow-bg {
                  color: var(--base-color-brand--yellow);
              }
              [data-wf--section--variant="dark"] .arrow-color {
                  color: var(--base-color-brand--black);
              }
              .quote-bot {
                  position: relative;
                  top: -50px;
                  left: -50px;
                  z-index: 0;
              }
