]{--number:63}[data-number="64"]{--number:64}[data-number="65"]{--number:65}[data-number="66"]{--number:66}[data-number="67"]{--number:67}[data-number="68"]{--number:68}[data-number="69"]{--number:69}[data-number="70"]{--number:70}[data-number="71"]{--number:71}[data-number="72"]{--number:72}[data-number="73"]{--number:73}[data-number="74"]{--number:74}[data-number="75"]{--number:75}[data-number="76"]{--number:76}[data-number="77"]{--number:77}[data-number="78"]{--number:78}[data-number="79"]{--number:79}[data-number="80"]{--number:80}[data-number="81"]{--number:81}[data-number="82"]{--number:82}[data-number="83"]{--number:83}[data-number="84"]{--number:84}[data-number="85"]{--number:85}[data-number="86"]{--number:86}[data-number="87"]{--number:87}[data-number="88"]{--number:88}[data-number="89"]{--number:89}[data-number="90"]{--number:90}[data-number="91"]{--number:91}[data-number="92"]{--number:92}[data-number="93"]{--number:93}[data-number="94"]{--number:94}[data-number="95"]{--number:95}[data-number="96"]{--number:96}[data-number="97"]{--number:97}[data-number="98"]{--number:98}[data-number="99"]{--number:99}[data-number="100"]{--number:100}

              [data-border="gray"] {
              border: 1px solid #868686 !important;
              }
              .background-bottom-right {
                  top: auto !important;
                  bottom: 0 !important;
                  right: 0 !important;
                  left: auto !important;
                  width: 33% !important;
                  height: auto !important;
                  overflow: hidden !important;
              }
              @media screen and (min-width: 992px) {
              [data-col-boxed="True"], [data-col2-boxed="True"] {
                  padding: var(--padding-boxed);
              }
              }

              .is-slider {
              	max-width: 48.9rem;
                margin-left: auto;
                margin-right: auto;
              }

              .swiper-gradient-bg {
              	background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 190, 255, 0.50) 58.65%), linear-gradient(0deg, rgba(0, 0, 0, 0.20) 0%, rgba(0, 0, 0, 0.20) 100%);
              }

              @media screen and (min-width: 580px) and (max-width: 1260px) {
                  .category-tag, .integration-name {
                     word-break: break-all;
                  }
              }
                /* Stack both buttons in one cell so they overlap perfectly */
              [data-btn-swap] { display: inline-grid; }
              [data-btn-swap] > .button-top,
              [data-btn-swap] > .button { grid-area: 1 / 1; }

              /* TOP STATE: show .button-top, hide .button */
              [data-btn-swap] > .button-top {
                opacity: 1; visibility: visible; pointer-events: auto;
                transition: opacity .35s ease, visibility 0s;
              }
              [data-btn-swap] > .button {
                opacity: 0; visibility: hidden; pointer-events: none;
                transition: opacity .35s ease, visibility 0s linear .35s;
              }

              /* SCROLLED STATE: swap them */
              [data-btn-swap="scrolled"] > .button-top {
                opacity: 0; visibility: hidden; pointer-events: none;
                transition: opacity .35s ease, visibility 0s linear .35s;
              }
              [data-btn-swap="scrolled"] > .button {
                opacity: 1; visibility: visible; pointer-events: auto;
                transition: opacity .35s ease, visibility 0s;
              }

              @media (prefers-reduced-motion: reduce) {
                [data-btn-swap] > .button-top,
                [data-btn-swap] > .button { transition: none; }
              }
                /* Arrow draws its own glyph, plus by default */
              .tab-title-arrow::after {
                content: "+";
                display: inline-block;
                line-height: 1;
              }

              /* Active tab: Webflow adds .w--current to the live tab link */
              .w--current .tab_text-wrapper {
                display: block;
              }

              .w--current .tab-title-arrow::after {
                content: "\2212"; /* true minus sign, swap for "-" if you prefer a hyphen */
              }
            .tab_text-wrapper {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.3s ease;
          }
          .tab_text-wrapper > * {
            overflow: hidden;
          }
          .w--current .tab_text-wrapper {
            grid-template-rows: 1fr;
          }

          @media (prefers-reduced-motion: reduce) {
            .tab_text-wrapper { transition: none; }
          }
          .tab_text-wrapper > * { overflow: hidden; }

        .tab-link-overview:not(.w--current) .tab_image-overview {
          display: none;
        }
        .tab-link-overview:not(.w--current) .tab_text {
        margin-top: 0;
        margin-bottom: 0;
      }
    .comparison-table .comparison-row:last-child {
    border-bottom: none;
  }
  /* Live site only: hide inactive panes and placeholders */
  html:not(.wf-design-mode) [data-tabs="component"]:not([data-tabs-ready]) [data-tabs="pane"] ~ [data-tabs="pane"] { display: none; }
  html:not(.wf-design-mode) [data-tabs="component"]:not([data-tabs-ready]) [data-tabs="card-icon"] { visibility: hidden; }
  html:not(.wf-design-mode) [data-tabs="pane"][hidden] { display: none !important; }
  .tabs_link.is-active .tabs_link-icon { opacity: 1; }

  /* Designer only: show every pane, outlined and labeled for editing */
  .wf-design-mode [data-tabs="pane"] { outline: 1px dashed rgba(255, 255, 255, 0.25); outline-offset: 1rem; margin-bottom: 3rem; }
  .wf-design-mode .tabs_meta { display: flex !important; align-items: center; gap: 0.5rem; font-size: 0.75rem; opacity: 0.6; }
  .best-for-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3em;
  }
  .best-for:not(:last-child) .text-weight-normal::after {
    content: ",";
  }
  .system-used:not(:last-child) .text-weight-normal::after {
    content: "+";
    margin-left: 0.3em;
  }
  /* Backgrounds (keeps colors and text pairing in one place) */
.testimonial_item:nth-child(4n+1) { background-color: #fff58c; }
.testimonial_item:nth-child(4n+2) { background-color: #9600ff; }
.testimonial_item:nth-child(4n+3) { background-color: #ffa8bb; }
.testimonial_item:nth-child(4n+4) { background-color: #f55200; }

/* Black text on yellow + pink */
.testimonial_item:nth-child(4n+1),
.testimonial_item:nth-child(4n+1) *,
.testimonial_item:nth-child(4n+3),
.testimonial_item:nth-child(4n+3) * {
  color: #000;
}

/* White text on purple + red */
.testimonial_item:nth-child(4n+2),
.testimonial_item:nth-child(4n+2) *,
.testimonial_item:nth-child(4n+4),
.testimonial_item:nth-child(4n+4) * {
  color: #fff;
} .testimonial_item:nth-child(4n+2) .testimonial_new-logo,
.testimonial_item:nth-child(4n+4) .testimonial_new-logo {
  filter: brightness(0) invert(1);
}
