});
</script></div></div></div><section data-anim="stars" class="section_tabs padding-xl"><div data-marquee-duplicate="2" data-marquee-scroll-direction-target="" data-marquee-direction="left" data-marquee-status="normal" data-marquee-speed="15" data-marquee-scroll-speed="10" class="marquee-advanced home"><div data-marquee-scroll-target="" class="marquee-advanced__scroll"><div data-marquee-collection-target="" class="marquee-advanced__collection"><p class="marquee__advanced__p">Move <span class="gradient_yellow-orange">work</span> forward faster</p><img src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/69baa80e836a5b6fa12a55d5_ship_image.svg" loading="lazy" alt="" class="image reverse"/></div><div data-marquee-collection-target="" class="marquee-advanced__collection"><p class="marquee__advanced__p">Move <span class="gradient_yellow-orange">work</span> forward faster</p><img src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/69baa80e836a5b6fa12a55d5_ship_image.svg" loading="lazy" alt="" class="image reverse"/></div><div data-marquee-collection-target="" class="marquee-advanced__collection"><p class="marquee__advanced__p">Move <span class="gradient_yellow-orange">work</span> forward faster</p><img src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/69baa80e836a5b6fa12a55d5_ship_image.svg" loading="lazy" alt="" class="image reverse"/></div></div></div></section><section data-anim="stars" class="section_plans"><div class="padding-global bot"><div class="container-tab"><div class="planet-placeholder desktop w-embed"><div class="planet-lottie" style="width: 100%; aspect-ratio: 1/1;">
  <video class="planet-video" muted playsinline preload="auto"
         src="https://wunderdogs.b-cdn.net/Fathom/planet-full-crf32.mp4"></video>
</div>
<style>
  .planet-video {
  width: 100%;
  height: 100%;
  object-fit: contain; /* keeps the circle undistorted inside the square */
  display: block;
}
</style></div><h2 class="text-align-center">Whether you’re a team of 1 or 1,000, Fathom’s got your back</h2><div class="glass_wrapper logos tabs-wrapper"><div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="w-tabs"><div class="tabs-menu w-tab-menu"><a data-w-tab="Tab 1" class="tab-link w-inline-block w-tab-link w--current"><div class="tab-text">Fathom for teams</div></a><a data-w-tab="Tab 2" class="tab-link w-inline-block w-tab-link"><div class="tab-text">Fathom for individuals</div></a></div><div class="tabs-content w-tab-content"><div data-w-tab="Tab 1" class="tab-wrapper w-tab-pane w--tab-active"><div class="grid-2"><div data-wf--main-content--variant="base" class="main-content"><div data-wf--typography-heading--variant="h3" class="text-rich-text inherit w-variant-d4a30f16-4f9e-336f-8177-13627420cb3d w-richtext"><h2>Shared visibility. Smarter execution.</h2></div><div data-wf--spacer--variant="spacer-small" class="spacer"></div><div data-wf--typography-rich-text--variant="text-regular" class="text-rich-text-2 w-richtext"><p>Fathom gives teams a shared source of truth across every customer conversation, internal sync, and strategy call – so decisions are visible, follow-through is consistent, and nothing gets lost between meetings.</p><p>Search conversations, spot patterns, and keep work moving without the manual work.</p></div><div data-wf--spacer--variant="spacer-small" class="spacer"></div><a data-tf-hidden-utm="" data-modal="False" data-wf--button--variant="base" href="/pricing?plan=teams" class="button grad w-inline-block"><p class="button-text">See our pricing</p><div class="button-gradient color"></div></a></div><div class="grid-2"><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c0a49791530f54cd55_0d860dfc5bc7a426568ad59993d5b2ef_T-I_1.svg" alt=""/><p class="text-size-small">Automatic notes, summaries, and updates reduce follow-ups and admin across the team.</p></div><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c053b0828f2b9f99a7_e9181d8ecfbc8b4d779a3fc73073820e_T-I_2.svg" alt=""/><p class="text-size-small">Turn conversations into clear next steps that move deals and projects forward.</p></div><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c017fb51b97deba785_ae33610220b7057efef8dbe525b0b6a2_T_3.svg" alt=""/><p class="text-size-small">Keep decisions, commitments, and customer signals visible across meetings and teams.</p></div><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c02e9680d1f39ac969_c451af2764a162cb16ff4c2abed8a432_T_4.svg" alt=""/><p class="text-size-small">Spot patterns, risks, and opportunities across conversations before they become problems.</p></div></div></div></div><div data-w-tab="Tab 2" class="tab-wrapper w-tab-pane"><div class="grid-2 tab-grid"><div data-wf--main-content--variant="base" class="main-content"><div data-wf--typography-heading--variant="h3" class="text-rich-text inherit w-variant-d4a30f16-4f9e-336f-8177-13627420cb3d w-richtext"><p>Fully present.</p><p>Always prepared.</p></div><div data-wf--spacer--variant="spacer-small" class="spacer"></div><div data-wf--typography-rich-text--variant="text-regular" class="text-rich-text-2 w-richtext"><p>Fathom captures every detail of your meetings so you can stay present, ask better questions, and never worry about missing something important.</p><p>Get clear summaries, searchable transcripts, and instant follow-ups without scrambling to take notes or recap the call.</p></div><div data-wf--spacer--variant="spacer-small" class="spacer"></div><a data-tf-hidden-utm="" data-modal="False" data-wf--button--variant="base" href="/pricing?plan=individuals" class="button grad w-inline-block"><p class="button-text">See our pricing</p><div class="button-gradient color"></div></a></div><div class="grid-2 mob-grid"><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c0a49791530f54cd55_0d860dfc5bc7a426568ad59993d5b2ef_T-I_1.svg" alt=""/><p class="text-size-small">Automatic notes and summaries eliminate manual follow-ups and admin saving 38-minutes per meeting on average.</p></div><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c053b0828f2b9f99a7_e9181d8ecfbc8b4d779a3fc73073820e_T-I_2.svg" alt=""/><p class="text-size-small">Stay engaged, ask better questions and build stronger relationships without worrying about capturing every detail.<br/></p></div><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c0f001b71861f02947_f904c7e71f4b28165b64fb5e2484bc90_I_3.svg" alt=""/><p class="text-size-small">Action items, key moments, and important context are recorded and searchable whenever you need them.</p></div><div class="icon-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/699cb8c0ff4aaf99548a20e4_9744d9e81f0ea3ed211a539b16c9fdec_I_4.svg" alt=""/><p class="text-size-small">Ask Fathom questions across past conversations and instantly surface key insights and clarity.</p></div></div></div></div></div></div></div><div class="code-embed w-embed w-script"><script>
(function () {
  function initPlanet() {
    gsap.registerPlugin(ScrollTrigger);
    const container = document.querySelector('.planet-lottie');
    const video = container && container.querySelector('.planet-video');
    if (!video) return;

    const mm = gsap.matchMedia();

    // Always draw a stable first frame so mobile (and pre-scrub desktop) shows the planet.
    video.addEventListener('loadeddata', () => {
      try { video.currentTime = 0; } catch (e) {}
    }, { once: true });

    // Desktop only: wire up the scroll scrub. Reverts below 992px.
    mm.add('(min-width: 992px)', () => {
      let built = false;

      const build = () => {
        if (built) return;
        built = true;
        const dur = video.duration || 1;
        const playhead = { t: 0 };

        gsap.to(playhead, {
          t: dur,
          ease: 'none',
          scrollTrigger: {
            trigger: container,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 2,
            invalidateOnRefresh: true,
          },
          onUpdate: () => {
            const t = Math.max(0, Math.min(dur, playhead.t));
            if (video.readyState >= 3) video.currentTime = t;
          },
        });

        ScrollTrigger.refresh();
      };

      let cpHandler = null;
      let safetyTimer = null;

      if (video.readyState >= 3) {
        build();
      } else {
        cpHandler = () => build();
        video.addEventListener('canplaythrough', cpHandler, { once: true });
        safetyTimer = setTimeout(() => {
          if (!built && video.readyState >= 1) build();
        }, 3000);
      }

      // Cleanup when leaving desktop: matchMedia kills the scrub ScrollTrigger,
      // and we reset the video to its static first frame.
      return () => {
        if (cpHandler) video.removeEventListener('canplaythrough', cpHandler);
        if (safetyTimer) clearTimeout(safetyTimer);
        try { video.currentTime = 0; } catch (e) {}
      };
    });
  }

  function whenReady() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      initPlanet();
      return;
    }
    let tries = 0;
    const timer = setInterval(function () {
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        clearInterval(timer);
        initPlanet();
      } else if (++tries > 100) {
        clearInterval(timer);
        console.warn('GSAP or ScrollTrigger never loaded. Check the global scripts in the footer.');
      }
    }, 50);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', whenReady);
  } else {
    whenReady();
  }
})();
</script></div><div class="hide w-embed"><style>

html {
  overflow-x: hidden;
}

