<!DOCTYPE html><html lang="en" class="dark bg-background" data-theme="dark"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- One-time email token (reset / set password). MUST stay the first script, above every analytics
       tag: GTM/GA page_location and the Reddit pixel read the full URL (fragment and query) when they
       load. Lifts #token= (or a legacy ?token=) on these two pages into window.__EMAIL_TOKEN__ and
       removes it from the URL before any of them run. Read by src/lib/url-token.ts. -->
  <script>
    (function () {
      try {
        var path = location.pathname.replace(/\/+$/, '');
        if (path !== '/reset-password' && path !== '/set-password') return;
        var hash = new URLSearchParams(location.hash.slice(1));
        var query = new URLSearchParams(location.search);
        var token = hash.get('token') || query.get('token');
        if (!token) return;
        window.__EMAIL_TOKEN__ = token;
        hash.delete('token');
        query.delete('token');
        var q = query.toString(), h = hash.toString();
        history.replaceState(history.state, '', location.pathname + (q ? '?' + q : '') + (h ? '#' + h : ''));
      } catch (e) { /* never block the page */ }
    })();
  </script>
  <!-- DataBull analytics (Andrej 10-26), PUBLIC PAGES ONLY (Security rule 10-26). The script sends the full
       URL and runs with the page's session, so it must never load on a private page (signed-in app,
       checkout/payment, auth links) or on a URL that can carry a secret. This loader decides at document
       load: it injects the tag only when the page starts on a public path whose query/fragment hold
       nothing but campaign keys. Once loaded, it stays out of private pages:
         - in-app navigation: history.pushState/replaceState are wrapped HERE, before the app and DataBull load
           (both capture them later): a same-origin URL that is not allowed never reaches the history; it becomes
           a full page load (location.assign / location.replace). DataBull only counts a pageview when the
           pathname changed after the call, so it never sees it. This also covers the router's own redirects,
           which bypass router blockers (ignoreBlocker). src/lib/analytics/databullGuard.ts additionally
           blocks ordinary router moves before the app starts rendering the private page;
         - back/forward: the popstate/hashchange listener below runs before the app's and DataBull's and
           reloads a non-allowed URL as a fresh document (without DataBull).
       window.__databullAllowed is the ONE rule set; the guard reuses it. Must stay AFTER the token lift. -->
  <script>
    (function () {
      try {
        // PATHS: default-deny. Only these known-public paths; any other path (incl. a new route) is private.
        var PUBLIC = /^\/(?:|blog|blog\/(?!preview(?:\/|$))[^/]+|contact|privacy|terms|refund|openclaw|what-to-build|open-demo|workflows|workflows\/[^/]+|login|signup|forgot-password)$/;
        // QUERY and FRAGMENT: ONE rule, an ALLOWLIST per path (default-deny, like paths), the denylist kept as a backstop.
        //   everywhere:               utm_*, ref, gclid, fbclid and the click-id family gad_source, gbraid, wbraid,
        //                             msclkid, ttclid, twclid, li_fat_id, igshid, mc_cid, oppref (ChatGPT ads: OpenAI appends
        //                             it to every ad click, our live paid channel), rdt_cid (Reddit)
        //                             (NOT mc_eid: a Mailchimp subscriber id). A NEW ad platform's click id must be added
        //                             here before its campaigns run, or its landings are private and untracked.
        //   /blog and /blog/<post>:   also page, category, tag (same path shape as PUBLIC)
        //   /login and /signup:       also redirect, a plain internal path only (the login page adds ?redirect=/dashboard)
        // Any other key means private. Backstop: a listed key that looks secret-bearing, or a value that looks like an
        // email, is private too. A fragment with "=" goes through the same rule; one without "=" is a plain in-page
        // anchor only if every -/_ separated part is short (#pricing, #step-1-get-api-key); a long opaque string is private.
        var GLOBAL_KEY = /^(?:utm_[a-z0-9_]+|ref|gclid|fbclid|gad_source|gbraid|wbraid|msclkid|ttclid|twclid|li_fat_id|igshid|mc_cid|oppref|rdt_cid)$/;
        var BLOG = /^\/blog(?:\/(?!preview(?:\/|$))[^/]+)?$/;
        var AUTH = /^\/(?:login|signup)$/;
        var SECRET_KEY = /^(?:t|e|k|u|p|sid|uid|otp|sig|pwd|pass|jwt|next|state|nonce|ticket|invite|magic|reset|verify|unsubscribe|callback|return_?to|redirect_uri|client_id|client_secret|code_challenge|code_verifier|user|user_id|userid)$|token|secret|passw|key|code|email|session|auth|signature|credential/i;
        var PLAIN_PATH = /^\/(?!\/)[A-Za-z0-9\/_-]*$/;   // e.g. /dashboard: no query, fragment, // or scheme
        var allowedKeyFor = function (path, k, v) {
          if (GLOBAL_KEY.test(k)) return true;
          if (BLOG.test(path) && /^(?:page|category|tag)$/.test(k)) return true;
          if (AUTH.test(path) && k === 'redirect') return PLAIN_PATH.test(v);
          return false;
        };
        var paramsOk = function (path, raw) {
          var ok = true;
          new URLSearchParams(raw).forEach(function (v, k) {
            if (!allowedKeyFor(path, k, v) || SECRET_KEY.test(k) || /@|%40/.test(v)) ok = false;
          });
          return ok;
        };
        var anchorOk = function (h) {
          if (!/^[A-Za-z0-9_-]{1,100}$/.test(h)) return false;
          var parts = h.split(/[-_]/);
          for (var i = 0; i < parts.length; i++) if (parts[i].length > 15) return false;
          return true;
        };
        var allowed = function (pathname, search, hash) {
          var path = String(pathname || '').replace(/\/+$/, '') || '/';
          if (!PUBLIC.test(path)) return false;
          var q = String(search || '').replace(/^\?/, '');
          if (q && !paramsOk(path, q)) return false;
          var h = String(hash || '').replace(/^#/, '');
          if (h && (h.indexOf('=') === -1 ? !anchorOk(h) : !paramsOk(path, h))) return false;
          return true;
        };
        window.__databullAllowed = allowed;
        if (!allowed(location.pathname, location.search, location.hash)) return;
        window.__DATABULL_ACTIVE__ = true;
        var leave = function (e) {
          if (allowed(location.pathname, location.search, location.hash)) return;
          e.stopImmediatePropagation();
          location.reload();
        };
        window.addEventListener('popstate', leave);
        window.addEventListener('hashchange', leave);
        // PATCH ORDER: these wrappers are installed here, in <head>, before anything else, so they are the
        // INNERMOST layer. The router's history (TanStack) captures history.pushState when it is created and
        // wraps it; DataBull wraps whatever is current when it loads (always later: it is injected below).
        // Every call therefore runs DataBull -> TanStack -> these -> native, in either load order. DataBull
        // counts a pageview only if location.pathname changed after the inner call, so a blocked URL is never
        // counted. Only a move that turns the page PRIVATE triggers the full load (this document is public, so
        // a same-URL or state-only call, scroll restoration or ?page=2 passes straight through). Once leaving,
        // further calls are swallowed: no second navigation, no reload loop.
        var leaving = false;
        var wrap = function (orig, hard) {
          return function (state, title, url) {
            if (leaving) return;
            if (url !== undefined && url !== null) {
              var u;
              try { u = new URL(String(url), location.href); } catch (e) { u = null; }
              if (!u || (u.origin === location.origin && u.href !== location.href && !allowed(u.pathname, u.search, u.hash))) {
                leaving = true;
                setTimeout(function () { leaving = false; }, 5000);   // if the full load is cancelled, don't stay latched
                hard(u ? u.href : String(url));
                return;
              }
            }
            return orig.apply(this, arguments);
          };
        };
        history.pushState = wrap(history.pushState, function (h) { location.assign(h); });
        history.replaceState = wrap(history.replaceState, function (h) { location.replace(h); });
        var s = document.createElement('script');
        s.defer = true;
        s.setAttribute('data-website-id', 'dc_5mnmo007s60y8t');
        s.setAttribute('data-domain', 'transcriptapi.com');
        // Payment Links: DataBull's native handling is ON (founder-approved anonymous Buy-link attribution, 10-27;
        // replaces our own binder, PR #184). At click time it adds client_reference_id=<visitor>__<session> to a
        // buy.stripe.com link ONLY when the link has none, so it never touches tapi_user_<id>: logged-in buyers are
        // bound by redirectLoggedInPurchase from the original href (window.location.href, which DataBull cannot see).
        // Provisioning ignores any value without the tapi_user_ prefix. DataBull's success-page linking (?session_id=)
        // cannot run: any URL with a session_id parameter is private above, so DataBull never loads there. Do NOT
        // add an "after payment" redirect to a public page with ?session_id= (it would need allow-listing a session id).
        // Rendered hrefs must still never carry identifiers: outbound-link tracking sends every external href
        // (renderedPurchaseHref, tests/purchase-href-pii.test.ts).
        s.src = 'https://databull.subscriptions-972.workers.dev/js/script.js';
        document.head.appendChild(s);
      } catch (e) { /* never block the page */ }
    })();
  </script>

  <!-- Browser chrome / address-bar tint on mobile + AI overview cards.
       Matches the dark theme background (--background: 0 0% 0%). Routed
       through the static shell rather than per-route PageMeta because
       the value is identical on every page (the site is dark-only). -->
  <meta name="theme-color" content="#000000">

