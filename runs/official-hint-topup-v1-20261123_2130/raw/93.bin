<path d="M4.1597e-05 13.6261L13.626 6.53978e-05L15.5518 1.92579L1.92577 15.5518L4.1597e-05 13.6261ZM0.437704 2.21757L2.18837 0.466903L15.0849 13.3635L13.3343 15.1141L0.437704 2.21757Z" fill="white"/>
</svg>
</div></a></div></div><div class="nav_embed-styles w-embed"><style>
  /* Shared dropdown tokens: design can tune contrast here without touching layout */
  [data-nav] {
    --nav-cyan: #00BEFF;                        /* open trigger text, scrolled CTA fill */
    --nav-mega-bg: rgba(25, 25, 25, .90);
    --nav-mega-border: rgba(255, 255, 255, .75);
    --nav-mega-radius: 30px;
    --nav-mega-shadow: 0 0 0 0 transparent;   /* e.g. 0 24px 64px rgba(0,0,0,.6) for more lift */
    --nav-mega-inset: 0px;                     /* 0 = box spans the full bar container */
    --nav-mega-pad-x: 3rem;                    /* side padding of panels and the CTA bar */
    --nav-featured-bg: rgba(255, 255, 255, .05);
  }

  /* Scroll color: layout and position live in the Designer, states live here */
  [data-nav] { background-color: transparent; transition: background-color .3s ease; }
  [data-nav][data-scrolled],
  [data-nav][data-menu-open] { background-color: #000000; }

  /* Burger icon swap and active trigger color */
  [data-nav-icon-close] { display: none; }
  [data-nav][data-menu-open] [data-nav-icon-open] { display: none; }
  [data-nav][data-menu-open] [data-nav-icon-close] { display: block; }
  /* Open item turns cyan: the label and chevron have their own colors, so set them directly */
  [data-nav-item][data-open] [data-nav-trigger],
  [data-nav-item][data-open] [data-nav-trigger] *,
  [data-nav-item][data-open] [data-nav-chevron] { color: var(--nav-cyan); }

  /* Chevron: fixed size so an SVG without width/height never collapses to 0 */
  /* position: static keeps it in the flex row (an absolute chevron sits outside the pill with no gap) */
  [data-nav-chevron] { position: static; inset: auto; margin: 0; flex-shrink: 0; width: .625rem; height: .625rem; line-height: 0; }
  [data-nav-chevron] svg { display: block; width: 100%; height: 100%; }

  /* Sticky-nav state (all breakpoints): sign-up CTA fills cyan blue once scrolled,
     stays outlined at the top and while the mobile menu is open */
  [data-nav-cta] { transition: background-color .3s, border-color .3s, color .3s; }
  [data-nav][data-scrolled]:not([data-menu-open]) [data-nav-cta] {
    background-color: var(--nav-cyan); border-color: var(--nav-cyan); color: #000000;
  }

  /* If a slot renders its own wrapper, let its children join the parent layout */
  [data-nav-panel-grid] > :not([data-nav-column]) { display: contents; }
  [data-nav-column] > :not([data-nav-group]) { display: contents; }

  /* Space between groups stacked in one column (gap lives on the column, not the slot) */
  [data-nav-panel] [data-nav-column] { display: flex; flex-direction: column; gap: 2.5rem; }

  /* Keep links whole inside two-column groups */
  [data-nav-link] { break-inside: avoid; }

  /* Link and Featured Card hover: text to #00BEFF, description to 70% white */
  [data-nav-link], [data-nav-featured], [data-nav-desc], [data-nav-featured-desc] { transition: color .2s ease; }
  :is([data-nav-link], [data-nav-featured]):focus-visible { color: #00BEFF; }
  :is([data-nav-link], [data-nav-featured]):focus-visible :is([data-nav-desc], [data-nav-featured-desc]) { color: rgba(255, 255, 255, 0.70); }
  @media (hover: hover) {
    :is([data-nav-link], [data-nav-featured]):hover { color: #00BEFF; }
    :is([data-nav-link], [data-nav-featured]):hover :is([data-nav-desc], [data-nav-featured-desc]) { color: rgba(255, 255, 255, 0.70); }
  }

  /* Icon state swap (Nav Link logos and Featured Card tiles): hover image fades over the default */
  [data-nav-icon-default], [data-nav-icon-hover] { transition: opacity .2s ease; }
  [data-nav-icon-hover] { opacity: 0; }
  :is([data-nav-link], [data-nav-featured]):focus-visible [data-nav-icon-hover] { opacity: 1; }
  :is([data-nav-link], [data-nav-featured]):focus-visible [data-nav-icon-default]:has(~ [data-nav-icon-hover]) { opacity: 0; }
  @media (hover: hover) {
    :is([data-nav-link], [data-nav-featured]):hover [data-nav-icon-hover] { opacity: 1; }
    :is([data-nav-link], [data-nav-featured]):hover [data-nav-icon-default]:has(~ [data-nav-icon-hover]) { opacity: 0; }
  }

  /* Desktop (992px and up): one shared floating box; panels swap inside it */
  @media (min-width: 992px) {
    [data-nav-bar] { position: relative; }

    /* Shared box: same width and position for every dropdown, only height animates */
    [data-nav-mega] {
      position: absolute; left: var(--nav-mega-inset); right: var(--nav-mega-inset); top: calc(100% + 1rem); z-index: 1;
      height: var(--nav-mega-h, 0px); overflow: hidden;
      border-radius: var(--nav-mega-radius); border: .75px solid var(--nav-mega-border);
      background: var(--nav-mega-bg);
      box-shadow: 0 2px 8px 0 rgba(255,255,255,.16) inset, var(--nav-mega-shadow);
      -webkit-backdrop-filter: blur(12.5px); backdrop-filter: blur(12.5px);
      opacity: 0; visibility: hidden;
      transition: opacity .2s ease, visibility 0s .2s, height .3s cubic-bezier(.4,0,.2,1);
    }
    [data-nav][data-mega-open] [data-nav-mega] {
      opacity: 1; visibility: visible;
      transition: opacity .2s ease, height .3s cubic-bezier(.4,0,.2,1);
    }
    /* First open: fade in at full height, no grow-from-zero */
    [data-nav][data-mega-instant] [data-nav-mega] { transition: opacity .2s ease; }

    /* CTA bar: one element, pinned to the box bottom, never swaps */
    [data-nav-mega-cta] {
      position: absolute; left: 0; right: 0; bottom: 0;
      display: flex; align-items: center; justify-content: flex-start; gap: 2rem;
      padding: 1.5rem var(--nav-mega-pad-x); border-top: 1px solid rgba(255,255,255,.12);
      transition: right .3s cubic-bezier(.4,0,.2,1);
    }
    /* Panels with a featured column: the CTA bar stops where the featured column starts */
    [data-nav][data-mega-featured] [data-nav-mega-cta] { right: var(--nav-mega-cta-right, 0px); } /* measured by the script */
    /* Featured tint continues beside the CTA bar (drawn by the box, so the panel above can scroll) */
    [data-nav-mega]::after {
      content: ""; position: absolute; right: 0; bottom: 0;
      width: var(--nav-mega-cta-right, 0px); height: var(--nav-mega-cta-h, 0px);
      background: var(--nav-featured-bg); opacity: 0; transition: opacity .18s ease;
    }
    [data-nav][data-mega-featured] [data-nav-mega]::after { opacity: 1; }
    [data-nav-mega-cta] > :not([data-nav-link]):not([data-nav-cta]):not(a):not(button) { display: contents; }

    /* Panels: transparent layers stacked at one spot over the box; switching only crossfades */
    [data-nav-panel] {
      position: absolute; left: var(--nav-mega-inset); right: var(--nav-mega-inset); top: 100%; z-index: 2; /* matches the box */
      opacity: 0; visibility: hidden;
      transition: opacity .18s ease, visibility 0s .18s;
    }
    [data-nav-item][data-open] [data-nav-panel] {
      opacity: 1; visibility: visible;
      transition: opacity .18s ease .06s;
    }
    /* The box owns the floating style now, so each panel's inner box goes transparent */
    [data-nav-panel] [data-nav-panel-inner] {
      max-width: none; margin: 0; background: none; border: 0; border-radius: 0; box-shadow: none;
      padding: 2.5rem var(--nav-mega-pad-x);
      /* Short screens: content scrolls inside the box, CTA bar stays put (height set by the script) */
      max-height: var(--nav-mega-scroll-h, none); overflow-x: hidden; overflow-y: auto;
      overscroll-behavior: contain; scrollbar-width: thin;
      -webkit-backdrop-filter: none; backdrop-filter: none;
    }

    /* Active top-level item: pill highlight, spacing in the bar unchanged */
    /* Active top-level item: text turns cyan (set above), no pill */
    [data-nav-trigger] { display: inline-flex; align-items: center; gap: .375rem; width: auto; transition: color .2s; }

    [data-nav-chevron] { transition: transform .2s; }
    [data-nav-item][data-open] [data-nav-chevron] { transform: rotate(180deg); }
    /* Columns: equal units, no dividers. Style prop on Nav Column: default | wide | featured */
    [data-nav-panel] [data-nav-column] { flex: 1 1 0; min-width: 0; padding: 0 2rem 0 0; border: 0 !important; }
    [data-nav-panel] [data-nav-column-style="wide"] { flex-grow: 2; }
    /* Featured: same width as the other columns, tinted, bleeds to the box's top and right edges; the box tints the strip beside the CTA bar */
    [data-nav-panel] [data-nav-column-style="featured"] {
      flex: 1 1 0;
      margin: -2.5rem calc(var(--nav-mega-pad-x) * -1) -2.5rem 0;
      padding: 2.5rem var(--nav-mega-pad-x);
      background: var(--nav-featured-bg);
      border-radius: 0 var(--nav-mega-radius) 0 0;
    }

    /* Panel columns: 3, 4 or 5 columns lay out with no restyle */
    [data-nav-panel] [data-nav-panel-grid] {
      display: flex; align-items: stretch;
      grid-template-rows: none; grid-template-columns: none; /* clear Webflow's default 2x2 grid if left on the class */
    }

    /* Panel footer (e.g. See all integrations): centered link above the CTA bar, no rule */
    [data-nav-panel-footer] {
      display: flex; justify-content: center;
      margin: 2.5rem 0 0; padding: 0; border: 0;
    }

    [data-nav-mobile-only] { display: none !important; }
  }

  /* Designer canvas preview: wf-design-mode only exists in the Designer, so staging and live ignore this.
     The script does not run on the canvas, so the box uses a fixed preview height there. */
  html.wf-design-mode [data-nav-preview="open"] [data-nav-panel] { opacity: 1; visibility: visible; transform: none; }
  html.wf-design-mode [data-nav]:has([data-nav-preview="open"]) [data-nav-mega] { opacity: 1; visibility: visible; height: 32rem; }
  html.wf-design-mode [data-nav][data-nav-preview="menu"] [data-nav-menu] { opacity: 1; visibility: visible; }

  @media (prefers-reduced-motion: reduce) {
    [data-nav], [data-nav-panel], [data-nav-menu], [data-nav-chevron], [data-nav-cta], [data-nav-mega], [data-nav-trigger],
    [data-nav-icon-default], [data-nav-icon-hover], [data-nav-link], [data-nav-desc],
    [data-nav-featured], [data-nav-featured-desc] { transition: none !important; }
  }
</style></div><div class="nav_embed-tablet w-embed"><style>
  /* Tablet and below (991px and down): full-screen menu, panels slide in */
  @media (max-width: 991px) {
    [data-nav-menu] {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: var(--nav-h, 4.5rem);
      z-index: 50;
      overflow-y: auto;
      overscroll-behavior: contain; /* above anything in the bar, so open panels cover it */
      background-color: #000000;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s,
        visibility 0s 0.25s;
    }
    [data-nav][data-menu-open] [data-nav-menu] {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.25s;
    }

    /* Dev note: bottom CTA stays pinned to the screen bottom while the menu is open
       (z-index 5 keeps it under open drilldown panels, which sit at 10) */
    [data-nav-menu-footer] {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 5;
      background-color: #000000;
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }

    [data-nav-panel] {
      position: fixed;
      inset: 0;
      z-index: 10;
      padding: 0; /* drop the desktop 1rem hover bridge so the sticky header sits flush at the top */
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: #000000;
      transform: translateX(100%);
      visibility: hidden;
      transition:
        transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s 0.35s;
    }
    [data-nav-item][data-open] [data-nav-panel] {
      transform: none;
      visibility: visible;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Columns and groups read as one list */
    [data-nav-column] {
      border-left: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    [data-nav-panel] [data-nav-column] {
      gap: 2rem;
    }

    /* Dropdown: list rows, drilldown header, flat black panel */
    [data-nav-trigger] {
      width: 100%;
      justify-content: space-between;
      padding: 1rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 1rem;
    }
    /* Drilldown header stays pinned while the panel scrolls */
    [data-nav-panel-header] {
      position: sticky;
      top: 0;
      z-index: 1;
      background-color: #000000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem;
    }
    [data-nav-panel-inner] {
      width: auto;
      max-width: none;
      padding: 0 1.25rem 2rem;
      background-color: #000000;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    [data-nav-panel-grid] {
      display: grid;
      grid-auto-flow: row;
      grid-template-rows: none;
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    [data-nav-panel-footer] {
      display: flex;
      justify-content: flex-start;
      margin: 2rem 0 0;
      padding: 0;
      border: 0;
    }

    /* Bar and menu (Step 7) */
    [data-nav-bar] {
      position: relative;
      padding: 1rem 1.25rem;
      justify-content: space-between;
    }
    [data-nav-menu] {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      /* bottom padding reserves room for the fixed footer so the last row is never hidden */
      padding: 0.5rem 1.25rem calc(9rem + env(safe-area-inset-bottom, 0px));
    }
    /* Menu items and Actions slots stack as one continuous column (no gap or desktop spacing between them) */
    [data-nav-menu] > :not([data-nav-menu-footer]) {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      flex: none;
      margin: 0;
      padding: 0;
    }
    /* Only links and dropdowns show in the mobile list: hides the desktop Sign up button in Actions */
    [data-nav-menu] > :not([data-nav-menu-footer]) > :not([data-nav-link]):not([data-nav-item]) {
      display: none;
    }

    /* Top-level links (Pricing, Book a demo, Log in) as full-width rows */
    [data-nav-menu] [data-nav-link]:not([data-nav-panel] [data-nav-link]) {
      width: 100%;
      padding: 1rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 1rem;
    }
    /* Links inside drilldown panels, and the See all footer link */
    [data-nav-panel] [data-nav-link] {
      padding: 0.75rem 0;
      font-size: 1rem;
    }
    [data-nav-panel-footer] [data-nav-link] {
      padding: 1.5rem 0 0;
    }
    /* Link text picks up the 1rem above even though it has its own desktop size */
    [data-nav-menu] [data-nav-link] * {
      font-size: inherit;
    }

    /* Two-column groups collapse to one column */
    [data-nav-group] > * {
      column-count: auto;
    }

    /* Sticky footer layout (stickiness is set above) */
    [data-nav-menu-footer] {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      margin: 0;
      padding-top: 1.5rem;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* Designer preview: the script does not run on the canvas, so anchor the menu under the bar instead of --nav-h */
    html.wf-design-mode [data-nav][data-nav-preview='menu'] [data-nav-menu] {
      position: absolute;
      top: 100%;
      height: 100vh;
    }

    [data-nav-desc],
    [data-nav-desktop-only],
    [data-nav-chevron] {
      display: none !important;
    }
  }

  @media (max-width: 991px) and (prefers-reduced-motion: reduce) {
    [data-nav-menu],
    [data-nav-panel] {
      transition: none !important;
    }
  }
</style></div><div class="nav_embed-script w-embed w-script"><script>
(() => {
  const nav = document.querySelector('[data-nav]');
  if (!nav || nav.dataset.navReady) return;
  nav.dataset.navReady = 'true';

  const items = [...nav.querySelectorAll('[data-nav-item]')];
  const toggle = nav.querySelector('[data-nav-toggle]');
  const bar = nav.querySelector('[data-nav-bar]') || nav;
  const mega = nav.querySelector('[data-nav-mega]');
  const megaCta = nav.querySelector('[data-nav-mega-cta]');
  const mobile = window.matchMedia('(max-width: 991px)');
  const canHover = window.matchMedia('(hover: hover)');
  const threshold = parseInt(nav.dataset.navThreshold, 10) || 20;
  const SWITCH_DELAY = 80;   /* hover intent while the box is open: passing over a trigger does not swap */
  const CLOSE_DELAY = 200;   /* grace period when the cursor leaves the bar and box */
  let openTimer;
  let closeTimer;
  let ticking = false;

  const desktopHover = () => !mobile.matches && canHover.matches;

  /* Scroll color */
  const updateScrolled = () => {
    nav.toggleAttribute('data-scrolled', window.scrollY > threshold);
    ticking = false;
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(updateScrolled); }
  }, { passive: true });
  updateScrolled();

  /* Bar bottom edge on screen, for the mobile menu offset (includes wrappers above the bar) */
  const setNavHeight = () => {
    nav.style.setProperty('--nav-h', Math.round(bar.getBoundingClientRect().bottom) + 'px');
  };

  /* Item state */
  const setItem = (item, open) => {
    item.toggleAttribute('data-open', open);
    item.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded', open);
  };
  const closeAll = (except) => items.forEach((i) => i !== except && setItem(i, false));
  const openItem = () => items.find((i) => i.hasAttribute('data-open'));

  /* Shared box height = active panel content + CTA bar */
  const sizeMega = (item) => {
    if (!mega || !item) return;
    const inner = item.querySelector('[data-nav-panel-inner]');
    const ctaH = megaCta ? megaCta.offsetHeight : 0;
    nav.style.setProperty('--nav-mega-cta-h', ctaH + 'px'); /* featured column bleeds down beside the CTA bar */
    const feat = item.querySelector('[data-nav-column-style="featured"]');
    nav.toggleAttribute('data-mega-featured', !!feat);
    if (feat && mega) { /* CTA bar stops where the featured column starts */
      const right = mega.getBoundingClientRect().right - feat.getBoundingClientRect().left;
      nav.style.setProperty('--nav-mega-cta-right', Math.max(0, Math.round(right)) + 'px');
    }
    /* Fit the viewport: if the panel is taller than the space below the bar, it scrolls inside the box */
    const contentH = inner ? inner.scrollHeight : 0;
    const avail = Math.max(160, Math.round(window.innerHeight - mega.getBoundingClientRect().top - 16 - ctaH));
    const fits = contentH <= avail;
    nav.style.setProperty('--nav-mega-scroll-h', fits ? 'none' : avail + 'px');
    nav.style.setProperty('--nav-mega-h', (fits ? contentH : avail) + ctaH + 'px');
  };

  /* Desktop: swap content inside the shared box; the box itself never moves */
  const showItem = (item) => {
    clearTimeout(openTimer);
    clearTimeout(closeTimer);
    if (item.hasAttribute('data-open')) return;
    const wasOpen = nav.hasAttribute('data-mega-open');
    if (!wasOpen) nav.setAttribute('data-mega-instant', '');
    closeAll(item);
    setItem(item, true);
    sizeMega(item);
    nav.setAttribute('data-mega-open', '');
    if (!wasOpen) requestAnimationFrame(() => requestAnimationFrame(() => nav.removeAttribute('data-mega-instant')));
  };
  const hideMega = () => {
    clearTimeout(openTimer);
    clearTimeout(closeTimer);
    closeAll();
    nav.removeAttribute('data-mega-open');
  };

  /* Mobile menu */
  const setMenu = (open) => {
    nav.toggleAttribute('data-menu-open', open);
    toggle?.setAttribute('aria-expanded', open);
    if (!open) hideMega();
    document.documentElement.style.overflow = open ? 'hidden' : '';
    window.lenis?.[open ? 'stop' : 'start']?.();
  };

  items.forEach((item) => {
    item.querySelector('[data-nav-panel-inner]')?.setAttribute('data-lenis-prevent', ''); /* wheel scrolls the panel, not the page */
    const trigger = item.querySelector('[data-nav-trigger]');
    if (!trigger) return;
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('type', 'button');
    if (trigger.tagName === 'A') trigger.setAttribute('role', 'button'); /* screen readers announce a Link trigger as a button */

    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const open = !item.hasAttribute('data-open');
      if (mobile.matches) { closeAll(item); setItem(item, open); return; } /* mobile: drilldown */
      open ? showItem(item) : hideMega();                                   /* desktop: click and keyboard */
    });

    item.querySelector('[data-nav-back]')?.addEventListener('click', (e) => {
      e.preventDefault();
      setItem(item, false);
      trigger.focus();
    });

    /* Hover intent: opens instantly from closed, waits SWITCH_DELAY when swapping */
    item.addEventListener('mouseenter', () => {
      if (!desktopHover()) return;
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      if (item.hasAttribute('data-open')) return;
      const delay = nav.hasAttribute('data-mega-open') ? SWITCH_DELAY : 0;
      openTimer = setTimeout(() => showItem(item), delay);
    });
  });

  /* Hovering a plain top-level link (Pricing, Log in, Book a demo) closes the box */
  nav.querySelectorAll('[data-nav-menu] [data-nav-link]').forEach((link) => {
    if (link.closest('[data-nav-panel]')) return;
    link.addEventListener('mouseenter', () => {
      if (!desktopHover() || !nav.hasAttribute('data-mega-open')) return;
      clearTimeout(openTimer);
      openTimer = setTimeout(hideMega, SWITCH_DELAY);
    });
  });

  /* The bar and box act as one hover area: leaving it closes after a grace period, coming back cancels */
  bar.addEventListener('mouseleave', () => {
    if (!desktopHover()) return;
    clearTimeout(openTimer);
    closeTimer = setTimeout(hideMega, CLOSE_DELAY);
  });
  bar.addEventListener('mouseenter', () => clearTimeout(closeTimer));

  /* Re-measure when panel content changes size (images loading, client edits, resize) */
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(() => { const item = openItem(); if (item && !mobile.matches) sizeMega(item); });
    items.forEach((item) => { const inner = item.querySelector('[data-nav-panel-inner]'); if (inner) ro.observe(inner); });
    if (megaCta) ro.observe(megaCta);
  }
  window.addEventListener('resize', () => {
    setNavHeight();
    const item = openItem();
    if (item && !mobile.matches) sizeMega(item);
  });
  setNavHeight();

  toggle?.setAttribute('aria-expanded', 'false');
  toggle?.addEventListener('click', (e) => {
    e.preventDefault();
    setMenu(!nav.hasAttribute('data-menu-open'));
  });
  nav.querySelectorAll('[data-nav-close]').forEach((btn) =>
    btn.addEventListener('click', (e) => { e.preventDefault(); setMenu(false); })
  );

  /* Close the mobile menu only when a real navigation link is clicked.
     Triggers, back and close buttons (even if built as Links) and "#" links are skipped. */
  nav.querySelector('[data-nav-menu]')?.addEventListener('click', (e) => {
    if (!mobile.matches) return;
    const link = e.target.closest('a[href]');
    if (!link || link.closest('[data-nav-trigger], [data-nav-back], [data-nav-close]')) return;
    const href = link.getAttribute('href');
    if (!href || href === '#') return;
    setMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const item = openItem();
    if (item) {
      mobile.matches ? setItem(item, false) : hideMega();
      item.querySelector('[data-nav-trigger]')?.focus();
    } else if (nav.hasAttribute('data-menu-open')) {
      setMenu(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!mobile.matches && !nav.contains(e.target)) hideMega();
  });

  mobile.addEventListener('change', () => { setMenu(false); hideMega(); setNavHeight(); });
})();
</script></div></nav></div><main class="main-wrapper"><section data-anim="stars" class="section_hero-3 padding-hero banner"><div class="padding-global padding-hero"><div class="container-large-8 relative"><div class="hero_grid"><div data-anim="container" class="hero_content-4"><h1 data-transition-typewriter=""><span class="text-weight-regular">AI notetaking</span> that is out of this world</h1><div class="hero_text-block"><p>Fathom summarizes your meetings so you can focus on the conversation. <strong>Now available bot-free.</strong></p></div><a data-tf-hidden-utm="" data-modal="False" data-wf--button--variant="base" href="https://fathom.video/users/sign_up" class="button grad w-inline-block"><p class="button-text">Get started - free forever</p><div class="button-gradient color"></div></a><div class="compliance-wrapper"><div class="compliance-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
