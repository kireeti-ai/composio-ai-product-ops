  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Fathom",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "AI Meeting Notetaker",
    "operatingSystem": "Web, macOS, Windows, iOS",
    "url": "https://www.fathom.ai/overview",
    "description": "Fathom captures meetings via bot or bot-free recording, generates live and post-call summaries with action items, supports Ask Fathom search across an account's calls, and syncs insights automatically into CRMs and other work tools.",
    "provider": {
      "@type": "Organization",
      "name": "Fathom",
      "url": "https://www.fathom.ai",
      "logo": "https://cdn.prod.website-files.com/6899da9beccbdbe92be49b5d/68e7961f4ff1cd5e326512f7_logo-wordmark-new.svg",
      "sameAs": [
        "https://www.linkedin.com/company/fathom-video",
        "https://www.g2.com/products/fathom-video/reviews",
        "https://www.producthunt.com/products/fathom"
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "bestRating": "5",
      "ratingCount": "6840"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Chris W. Sr." },
        "reviewBody": "Post-meeting action items are gold, and the Ask Fathom feature makes it easy to pull specific answers out of a call.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Eduardo K." },
        "reviewBody": "A real game changer for meetings — staying focused during the call instead of taking notes, with recap, summaries, highlights, and stats that make everything easier and more profitable.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Elkin D. G." },
        "reviewBody": "Great customer support, strong AI-powered recording analysis, and easy setup that has increased the way meetings are analyzed, with easy integration into major remote-meeting platforms.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Tom W." },
        "reviewBody": "Convenient to share recording links, easy to get a clear and actionable summary, and it has significantly improved sales call hand-off between staff.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "George G." },
        "reviewBody": "Changed how meetings are handled, capturing small important details that would otherwise be missed while staying focused on the conversation.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Derek B." },
        "reviewBody": "Transformative for the sales team's productivity and data integrity — the Google Meet and HubSpot integration made forecast calls far more accurate.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Alejandro G." },
        "reviewBody": "Non-intrusive call recording with same-day implementation, letting the team mark portions of calls to train the AI and prompt it later for summaries.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Pamela H." },
        "reviewBody": "Used for recording sales and product training calls, with transcripts exported to ask detailed follow-up questions, backed by excellent customer support.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Stephen C." },
        "reviewBody": "Eliminates the administrative drag of note-taking with accurate auto-capture and CRM integration, freeing sellers to focus on strategy instead of data entry.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      }
    ]
  },
  {
    "@context": "https://schema.org",
