                L8 6
                A6 6 0 0 1 9.9 5
                L10.7 3.2
                Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </div>
          <div class="otter-tip-body">
            <div class="otter-tip-title">Manage Otter Notetaker Settings</div>
            <div class="otter-tip-text">
              All Notetaker settings (e.g., <strong>auto-share</strong>, <strong>auto-join</strong>) can be managed in <strong><a href="https://otter.ai/setting/share-notes?utm_source=help_center&amp;utm_medium=homepage&amp;utm_campaign=tips" target="_blank" rel="noopener noreferrer">Account Settings → Meetings</a></strong>.
            </div>
          </div>
        </div>

        <!-- Tip 3: Record without headphones -->
        <div class="otter-tip-card">
          <div class="otter-tip-icon" aria-hidden="true">
            <svg class="otter-tip-icon-svg" viewBox="0 0 24 24" role="presentation" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12a8 8 0 0 1 16 0" />
              <rect x="3" y="12" width="4" height="8" rx="2" ry="2" />
              <rect x="17" y="12" width="4" height="8" rx="2" ry="2" />
            </svg>
          </div>
          <div class="otter-tip-body">
            <div class="otter-tip-title">Record Botless</div>
            <div class="otter-tip-text">
              Download our <strong><a href="https://otter.ai/integrations/desktop?utm_source=help_center&amp;utm_medium=homepage&amp;utm_campaign=tips" target="_blank" rel="noopener noreferrer">Desktop app</a></strong> to record meetings without Notetaker.
            </div>
          </div>
        </div>
      </div>
