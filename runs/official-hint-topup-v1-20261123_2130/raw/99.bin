rotocol.io/v0.1/servers/com.transcriptapi%2Fyoutube-transcript-and-youtube-search/versions/latest","https://glama.ai/mcp/connectors/com.transcriptapi/youtube-transcript-and-youtube-search","https://glama.ai/mcp/servers/ZeroPointRepo/youtube-mcp","https://mcpmarket.com/server/transcriptapi","https://lobehub.com/mcp/zeropointrepo-youtube-mcp","https://github.com/ZeroPointRepo/youtube-mcp","https://github.com/ZeroPointRepo/youtube-skills","https://x.com/TranscriptAPI"]}</script><script type="application/ld+json" data-page-jsonld="1">{"@context":"https://schema.org","@type":"WebSite","@id":"https://transcriptapi.com/#website","name":"TranscriptAPI","alternateName":"YouTubeTranscriptAPI","url":"https://transcriptapi.com","publisher":{"@id":"https://transcriptapi.com/#organization"}}</script><script type="application/ld+json" data-page-jsonld="1">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"TranscriptAPI","alternateName":["YouTubeTranscriptAPI","youtubetranscriptapi"],"applicationCategory":"DeveloperApplication","description":"YouTube transcript API with video search, channel browsing, and playlist extraction. REST API, YouTube MCP for ChatGPT & Claude, and AI agent skills. Powers 15M+ transcripts/month.","url":"https://transcriptapi.com","operatingSystem":"Any","offers":{"@type":"AggregateOffer","priceCurrency":"USD","lowPrice":"5.00","highPrice":"54.00","offerCount":"2","offers":[{"@type":"Offer","name":"Starter Monthly","price":"5.00","priceCurrency":"USD","priceValidUntil":"2026-12-31","availability":"https://schema.org/InStock"},{"@type":"Offer","name":"Starter Annual","price":"54.00","priceCurrency":"USD","priceValidUntil":"2026-12-31","availability":"https://schema.org/InStock"}]},"provider":{"@id":"https://transcriptapi.com/#organization"},"featureList":["YouTube transcript extraction API","YouTube video and channel search","Channel video browsing and playlist extraction","YouTube MCP (Model Context Protocol) for ChatGPT and Claude","AI agent skills for OpenClaw, Claude Code, Cursor, and more","Multi-language transcript support","15M+ transcripts processed monthly"],"screenshot":"https://transcriptapi.com/docs/og/mcp/chatgpt.png"}</script><script type="application/ld+json" data-page-jsonld="1">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is TranscriptAPI free?","acceptedAnswer":{"@type":"Answer","text":"You can start for free: new accounts get 100 free credits, no card required, and one transcript costs one credit. After that, the paid plan is $5 a month for 1,000 credits per month, or $54 a year billed annually."}},{"@type":"Question","name":"Is TranscriptAPI the same as youtubetranscriptapi?","acceptedAnswer":{"@type":"Answer","text":"No. TranscriptAPI is a hosted REST API, separate from the open-source YouTubeTranscriptApi Python package, which fetches transcripts from your own machine. TranscriptAPI is managed and also adds YouTube search, channel browsing and playlist extraction."}},{"@type":"Question","name":"Can I use it from Python or JavaScript?","acceptedAnswer":{"@type":"Answer","text":"Yes. TranscriptAPI is a REST API, so any language that can send an HTTPS request with a Bearer API key can call it, including Python and JavaScript with Node.js. The API reference includes complete code examples in cURL, Python and JavaScript."}},{"@type":"Question","name":"Does it use my YouTube Data API quota?","acceptedAnswer":{"@type":"Answer","text":"No. You sign in with your own TranscriptAPI credentials: an API key, or OAuth for some MCP clients. You do not need a Google or YouTube Data API key, so no YouTube Data API quota of yours is used. Usage is counted in TranscriptAPI credits instead."}},{"@type":"Question","name":"Does it work with AI agents (MCP)?","acceptedAnswer":{"@type":"Answer","text":"Yes. TranscriptAPI runs an MCP server at https://transcriptapi.com/mcp. The MCP docs have setup guides for Claude and ChatGPT, which connect with OAuth, and OpenAI Agent Builder, which uses an API key. It works with any MCP-compatible client, and MCP calls use the same credits as the REST API."}}]}</script></head>

