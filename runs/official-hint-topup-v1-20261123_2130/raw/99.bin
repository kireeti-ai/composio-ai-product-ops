imary/20 via-primary/10 to-transparent"></div><div class="relative rounded-2xl p-px transition-all duration-500 bg-gradient-to-br from-white/[0.25] via-white/[0.12] to-white/[0.04] group-hover:from-primary/30 group-hover:via-primary/10 group-hover:to-transparent"><div class="relative rounded-[calc(1rem-1px)] bg-surface-2 p-6 md:p-8 overflow-hidden"><div class="absolute -top-24 -left-24 w-64 h-64 rounded-full blur-3xl pointer-events-none transition-opacity duration-500 bg-primary/[0.04] group-hover:bg-primary/[0.08]"></div><div class="relative"><div class="flex flex-wrap items-center gap-3 mb-3"><h3 class="text-xl md:text-2xl font-semibold tracking-tight">Extract Playlist Videos</h3><span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium tracking-wide bg-primary/10 text-primary ring-1 ring-primary/20">1 credit</span></div><p class="text-muted-foreground leading-relaxed max-w-2xl mb-4">Get every video from a YouTube playlist. Process entire courses, lecture series, or curated collections in a single call.</p><div class="flex flex-wrap gap-2 mb-6"><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Online courses</span><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Lecture series</span><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Curated collections</span><span class="bg-white/[0.04] text-muted-foreground/70 text-xs rounded-full px-3 py-1 ring-1 ring-white/[0.06]">Batch processing</span></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-4"><div class="rounded-lg border border-white/[0.06] overflow-hidden h-full flex flex-col"><div class="flex-1"><div class="flex items-center justify-between px-3 py-1.5 bg-white/[0.03] border-b border-white/[0.06]"><span class="text-[10px] uppercase tracking-wider text-muted-foreground/50 font-medium">Request</span><button type="button" cla