  <!-- Reddit Pixel — conversion tracking for Reddit Ads.
       Gated to the production host so it NEVER fires from the Dev
       satellite, local dev, or the build-time prerender (Puppeteer loads
       every route from localhost) — keeping the Reddit pixel's conversion
       data clean (no phantom PageVisits from non-prod). The advertiser /
       pixel ID (a2_…) is a public, client-side value, not a secret.
       The SignUp conversion is fired on account activation from
       verify-email.tsx via window.rdt — see src/lib/reddit-pixel.ts. -->
  <script>
    (function () {
      var h = location.hostname;
      if (h !== 'transcriptapi.com' && h !== 'www.transcriptapi.com') return;
      !function (w, d) { if (!w.rdt) { var p = w.rdt = function () { p.sendEvent ? p.sendEvent.apply(p, arguments) : p.callQueue.push(arguments) }; p.callQueue = []; var t = d.createElement("script"); t.src = "https://www.redditstatic.com/ads/pixel.js", t.async = !0; var s = d.getElementsByTagName("script")[0]; s.parentNode.insertBefore(t, s) } }(window, document);
      rdt('init', 'a2_i94rydl0z00r');
      rdt('track', 'PageVisit');
    })();
  </script>
  <!-- End Reddit Pixel -->
