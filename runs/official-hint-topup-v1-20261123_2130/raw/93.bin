<script>
(function () {
  function initTypeformPopup() {
    if (!window.tf) return;
    document.querySelectorAll('.typeform-trigger').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const utmValue = btn.getAttribute('data-tf-hidden-utm');
        const options = utmValue
          ? { size: 80, hidden: { utm_content: utmValue } }
          : { size: 80 };
        const { open } = window.tf.createPopup('AYeoqHBS', options);
        open();
      });
    });
  }
  var script = document.createElement('script');
  script.src = 'https://embed.typeform.com/next/embed.js';
  script.onload = initTypeformPopup;
  document.body.appendChild(script);
})();
</script>
