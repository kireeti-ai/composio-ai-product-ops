    <section class="otter-tips-wrapper otter-resources-section" aria-label="Helpful Otter resources">
      <div class="otter-tips-row">
        <!-- Tip 1: Otter Chat & Quick Search -->
        <div class="otter-tip-card">
          <div class="otter-tip-icon" aria-hidden="true">
            <svg class="otter-tip-icon-svg" viewBox="0 0 24 24" role="presentation">
              <rect x="4" y="6" width="10" height="1.6" rx="0.8"></rect>
              <rect x="4" y="11" width="8" height="1.6" rx="0.8"></rect>
              <rect x="4" y="16" width="6" height="1.6" rx="0.8"></rect>
              <circle cx="17" cy="11" r="3.2" fill="none"></circle>
              <line x1="19.7" y1="13.7" x2="21.5" y2="15.5"></line>
            </svg>
          </div>
          <div class="otter-tip-body">
            <div class="otter-tip-title">Otter Chat &amp; Quick Search</div>
            <div class="otter-tip-text">
              Press <strong>⌘/Ctrl + K</strong> to open the search bar to ask Otter Chat or search for conversations.
            </div>
          </div>
        </div>

        <!-- Tip 2: Manage Notetaker settings -->
        <div class="otter-tip-card">
          <div class="otter-tip-icon" aria-hidden="true">
            <svg class="otter-tip-icon-svg" viewBox="0 0 24 24" role="presentation" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="
                M12 3
