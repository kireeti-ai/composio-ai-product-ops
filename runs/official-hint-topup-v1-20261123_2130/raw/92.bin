<!-- Amplitude SDK -->
<script src="https://cdn.amplitude.com/script/1edd6ec91d887d8778846bbb67d6db08.js"></script>
<script>
  window.amplitude.add({
  name: "zendesk_event_enrichment",
  type: "enrichment",
  setup: function () {
    return Promise.resolve();
  },
  execute: function (evt) {
    evt.platform = "Zendesk";

    try {
      var properties = evt.event_properties;
      var elementText = properties["[Amplitude] Element Text"];
      var elementTag = properties["[Amplitude] Element Tag"];
      var elementClass = properties["[Amplitude] Element Class"];
      var elementParentLabel = properties["[Amplitude] Element Parent Label"];
      var pageTitle = properties["[Amplitude] Page Title"];
      var pageLocation = properties["[Amplitude] Page Location"];
      var pagePath = properties["[Amplitude] Page Path"];
  
  var formId =
  properties[
    "[Amplitude] Form ID"
  ];

if (
  (
    evt.event_type ===
      "[Amplitude] Form Started" ||
    evt.event_type ===
      "[Amplitude] Form Submitted"
  ) &&
  formId === "otter_docs_form"
) {
  return null;
}

      if (evt.event_type === "WebPageView") {
        var url = new URL(pageLocation);
        evt.event_properties = {
          ...properties,
          origin: url.origin,
          path: pagePath,
          search: url.search,
        };
      } else if (evt.event_type === "[Amplitude] Element Clicked") {
        if (elementTag === "button") {
          evt.event_type = "Zendesk_ButtonClick";

          if (elementParentLabel === "Was this article helpful?") {
            evt.event_type = "Article_Helpful";
            evt.event_properties = {
              ...properties,
              WasHelpful: elementText === "Yes",
            };
          } else if (elementText === "Follow") {
            evt.event_type = "Article_Follow";
            evt.event_properties = {
              ...properties,
              ArticleName: pageTitle,
            };
          }
        } else if (elementText === "Yes, close my request") {
          evt.event_type = "SupportTicket_Closed";
        } else if (elementText === "No, I need help") {
          evt.event_type = "SupportTicket_NeedsHelp";
        } else if (elementClass === "search-container") {
          evt.event_type = "SearchBar_Clicked";
        } else if (elementClass.includes("intercom")) {
          evt.event_type = "Intercom_Clicked";
        } else if (elementClass.includes("nesty-panel") || elementClass.includes("request_")) {
					return null;
  			}
      } else if (evt.event_type === "[Amplitude] Form Submitted") {
        evt.event_type = "SupportTicket_Submitted";
      } else if (evt.event_type === "[Amplitude] Form Started" && properties["[Amplitude] Form ID"] === "new_request") {
        evt.event_type = "SupportTicket_Started";
      }
    } catch (err) {}

    return Promise.resolve(evt);
  },
});

  var amplitudeApiKey = "1edd6ec91d887d8778846bbb67d6db08";
  let anonymousId = null;

  function findExistingAnonymousId() {
    var cookies = document.cookie.split("; ");

    try {
      var cookieName = "AMP_" + amplitudeApiKey.substring(0, 10);
      var cookie = cookies.find(function (c) {
        return c.startsWith(cookieName);
      });
      if (cookie) {
        var value = cookie.split("=")[1];
        var decoded = JSON.parse(decodeURIComponent(atob(value)));
        if (decoded.deviceId) {
          anonymousId = decoded.deviceId;
          return;
        }
      }
    } catch (e) {}

    try {
      var legacyName = "amp_" + amplitudeApiKey.substring(0, 6);
      var legacyCookie = cookies.find(function (c) {
        return c.startsWith(legacyName);
      });
      if (legacyCookie) {
        var deviceId = legacyCookie.split("=")[1].split(".")[0];
        if (deviceId) {
          anonymousId = deviceId; 
          return;
        }
      }
    } catch (e) {}

    try {
      var rudderCookie = cookies.find(function (c) {
        return c.startsWith("rl_anonymous_id=");
      });
      if (rudderCookie) {
        var rudderValue = rudderCookie.split("=")[1];
        if (rudderValue) anonymousId = rudderValue;
      }
    } catch (e) {}

    try {
      var rudderLocalStorage = localStorage.getItem("rl_anonymous_id");
      if (rudderLocalStorage) anonymousId = rudderLocalStorage;
    } catch (e) {}
  }

  findExistingAnonymousId();

  window.amplitude.init(amplitudeApiKey, {
    fetchRemoteConfig: true,
    ...(anonymousId && { deviceId: anonymousId }),
    autocapture: {
  pageViews: { eventType: "WebPageView" },
  elementInteractions: { cssSelectorAllowlist: ["button"] },
  formInteractions: true  // restores SupportTicket_Started + SupportTicket_Submitted
},
  });
</script>
<!-- End of Amplitude SDK -->

  


<script>
(function () {
  var isArticle = /\/hc\/[^/]+\/articles\/\d+/.test(window.location.pathname);
  if (!isArticle) return;

  function hasCodeBlocks() {
    return !!document.querySelector(
      "pre.wysiwyg-code-block, .article-body pre, .article-content pre, .w-embed pre"
    );
  }

  function loadPrism() {
    if (window.__prismLoaded) return;
    window.__prismLoaded = true;

    // Prism CSS (Default theme = light)
    var link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "/hc/theming_assets/01KFKXRJ8AGFQ8D4X88SNXCQWA";
    document.head.appendChild(link);

    // Prism core
    var core = document.createElement("script");
    core.defer = true;
    core.src = "/hc/theming_assets/01KFKXRKVGA4NC9KR3MX3QH7J3";

    // Prism autoloader
    var auto = document.createElement("script");
    auto.defer = true;
    auto.src = "/hc/theming_assets/01KFKXRK36TKV5WC44KDWS5RRE";

    core.onload = function () {
      document.head.appendChild(auto);
    };

    auto.onload = function () {
      try {
        if (window.Prism && Prism.plugins && Prism.plugins.autoloader) {
          Prism.plugins.autoloader.languages_path =
            "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/";
        }
      } catch (e) {}

      // Let script.js know Prism is ready
      try { window.dispatchEvent(new Event("otter:prism-ready")); } catch (e) {}
    };

    document.head.appendChild(core);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      if (hasCodeBlocks()) loadPrism();
    }, { once: true });
  } else {
    if (hasCodeBlocks()) loadPrism();
  }
})();
</script>
  
    
