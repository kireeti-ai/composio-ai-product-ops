  gsap.registerPlugin(ScrollTrigger);
  
  gsap.to('.swiper-gradient-bg', {
    y: () => window.innerHeight * 0.9,   // positive = moves DOWN (parallax)
    ease: 'none',
    scrollTrigger: {
      trigger: '.swiper-gradient-bg',
      start: 'top bottom',
      end: 'bottom top',
